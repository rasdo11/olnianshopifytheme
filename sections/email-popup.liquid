{%- if settings.enable_email_popup -%}
  <div
    class="email-popup email-popup--{{ section.settings.tab_position | default: 'right' }}"
    style="--email-tab-font-size: {{ section.settings.tab_font_size | default: 26 }}px; --email-tab-bg: {{ section.settings.tab_background | default: '#C6D0FF' }};"
    data-email-popup
    data-popup-delay="{{ settings.email_popup_delay | default: 5 }}"
    data-peek-duration="{{ section.settings.tab_peek_duration | default: 3 }}"
    aria-hidden="true"
  >
    {%- comment -%}
      The tab arrives expanded ("10% off your first order"), holds for tab_peek_duration
      seconds, then collapses to the short pill so it stops competing with the page. The
      peek text is a separate span that animates its width, so both states read as one
      sentence rather than swapping copy.
    {%- endcomment -%}
    <button type="button" class="email-popup__tab" data-email-popup-open aria-label="Open 10 percent off email signup">
      <span class="email-popup__tab-label">{{ section.settings.tab_label | default: '10% off' }}</span>
      {%- if section.settings.tab_peek_label != blank -%}
        <span class="email-popup__tab-peek" aria-hidden="true"><span>{{ section.settings.tab_peek_label }}</span></span>
      {%- endif -%}
    </button>
    <div class="email-popup__overlay" data-email-popup-close></div>
    <div
      class="email-popup__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="EmailPopupTitle"
    >
      <button type="button" class="email-popup__close" data-email-popup-close aria-label="Close email signup">×</button>
      <p class="email-popup__kicker">{{ section.settings.kicker | default: 'First order treat' }}</p>
      <h2 class="email-popup__title" id="EmailPopupTitle">{{ section.settings.headline | default: 'Enjoy 10% off' }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="email-popup__body">{{ section.settings.body }}</p>
      {%- endif -%}
      {%- form 'customer', id: 'EmailPopupCustomerForm', class: 'email-popup__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,popup">
        <label class="visually-hidden" for="EmailPopupEmail">Email address</label>
        <input
          id="EmailPopupEmail"
          class="email-popup__input"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="{{ section.settings.placeholder | default: 'Email address' }}"
          autocomplete="email"
          required>
        <button type="submit" class="email-popup__submit" aria-label="Submit email signup">→</button>
        {%- if form.posted_successfully? -%}
          <div class="email-popup__success" role="status" data-email-popup-result="success">
            <p>{{ section.settings.success_message | default: 'Thanks, check your inbox for 10% off.' }}</p>
            {%- comment -%}
              The code is shown right away instead of only promised by email. The discount
              itself (limits, eligible products) lives in Shopify Admin → Discounts; the Shop
              link goes through /discount/CODE, which stores the code for checkout.
            {%- endcomment -%}
            {%- assign _code = section.settings.discount_code | strip -%}
            {%- if _code != blank -%}
              {%- assign _discount_url = routes.root_url | append: '/discount/' | append: _code | replace: '//discount', '/discount' -%}
              <div class="email-popup__code">
                <span class="email-popup__code-value" data-email-popup-code>{{ _code | escape }}</span>
                <button type="button" class="email-popup__code-copy" data-email-popup-copy data-copied-label="Copied">Copy</button>
              </div>
              {%- if section.settings.code_note != blank -%}
                <p class="email-popup__code-note">{{ section.settings.code_note }}</p>
              {%- endif -%}
              <a class="btn btn--primary email-popup__code-shop" href="{{ _discount_url }}?redirect={{ routes.all_products_collection_url | url_encode }}">{{ section.settings.shop_label | default: 'Shop with 10% off' }}</a>
            {%- endif -%}
          </div>
        {%- elsif form.errors -%}
          <p class="email-popup__fineprint" role="alert" data-email-popup-result="error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endform -%}
      <p class="email-popup__fineprint">{{ section.settings.fineprint | default: 'Offer valid for new email subscribers. By signing up, you agree to receive email from OLNIAN.' }}</p>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Email popup",
  "settings": [
    { "type": "text", "id": "tab_label", "label": "Collapsed button label", "default": "10% off" },
    { "type": "text", "id": "tab_peek_label", "label": "Expanded peek text", "default": "your first order", "info": "Shown beside the label when the button first appears, then it collapses. Reads as one phrase with the label, e.g. \"10% off your first order\". Leave empty to disable the peek." },
    { "type": "range", "id": "tab_peek_duration", "label": "Peek duration", "min": 0, "max": 10, "step": 1, "unit": "s", "default": 3, "info": "How long the button stays expanded before shrinking. 0 disables the peek." },
    { "type": "select", "id": "tab_position", "label": "Collapsed button position", "default": "right", "options": [
      { "value": "right", "label": "Bottom right" },
      { "value": "left", "label": "Bottom left" }
    ]},
    { "type": "range", "id": "tab_font_size", "label": "Collapsed button font size", "min": 16, "max": 40, "step": 1, "unit": "px", "default": 26 },
    { "type": "color", "id": "tab_background", "label": "Collapsed button color", "default": "#C6D0FF" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "First order treat" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Enjoy 10% off" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Sign up for emails and receive 10% off your first order." },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Email address" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "You're in! Here's your 10% off code:" },
    { "type": "text", "id": "discount_code", "label": "Discount code shown after signup", "info": "Must match an active code in Shopify Admin → Discounts. Leave empty to show only the success message.", "default": "WELCOME10" },
    { "type": "text", "id": "code_note", "label": "Note under the code", "default": "Valid on one-time purchases. It's applied automatically when you shop from here." },
    { "type": "text", "id": "shop_label", "label": "Shop button label", "default": "Shop with 10% off" },
    { "type": "textarea", "id": "fineprint", "label": "Fine print", "default": "Offer valid for new email subscribers. By signing up, you agree to receive email from OLNIAN." }
  ]
}
{% endschema %}
