<section class="product page-enter"{% if section.settings.background_image != blank %} style="
  background-image: url({{ section.settings.background_image | image_url: width: 2400 }});
  background-size: {{ section.settings.background_image_size | default: 'cover' }};
  background-position: {{ section.settings.background_image_position | default: 'center center' }};
  background-repeat: no-repeat;
"{% endif %}>
  <div class="container">
    <div class="product__grid">

      {%- comment -%} ── Left: image gallery ── {%- endcomment -%}
      <div class="product__media">

        {%- comment -%}
          Gallery sources (all Theme Editor controlled):
          1. hero_image_filename setting - first slide, editable in Theme Editor
          2. gallery_image blocks - add/remove in Theme Editor via "Add block"
        {%- endcomment -%}
        {%- assign use_product_media = section.settings.use_product_media -%}
        {%- assign _hero_file = section.settings.hero_image -%}
        {%- assign gallery_asset_count = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'gallery_image' and block.settings.image != blank -%}
            {%- assign gallery_asset_count = gallery_asset_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
        {%- assign total_slides = gallery_asset_count -%}
        {%- if _hero_file != blank -%}{%- assign total_slides = total_slides | plus: 1 -%}{%- endif -%}
        {%- if use_product_media and product.images.size > 0 -%}
          {%- assign total_slides = product.images.size -%}
        {%- endif -%}
        {%- assign has_gallery = false -%}
        {%- if total_slides > 0 -%}{%- assign has_gallery = true -%}{%- endif -%}

        <div class="pdp-gallery">

          {%- comment -%} Hero image - large, full column width, clickable to open lightbox {%- endcomment -%}
          <div class="pdp-gallery__main" id="PdpMainImage">
            {%- if has_gallery -%}
              {%- assign _slide_i = 0 -%}
              {%- if use_product_media and product.images.size > 0 -%}
                {%- for image in product.images -%}
                  <div class="pdp-gallery__slide{% if forloop.first %} is-active{% endif %}" data-slide="{{ forloop.index0 }}">
                    <button type="button" class="pdp-gallery__main-btn" data-lightbox-open="{{ forloop.index0 }}" aria-label="View full image">
                      <img src="{{ image | image_url: width: 1400 }}" alt="{{ image.alt | default: product.title }}" class="pdp-gallery__img" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
                    </button>
                  </div>
                {%- endfor -%}
              {%- else -%}
                {%- if _hero_file != blank -%}
                  <div class="pdp-gallery__slide is-active" data-slide="0">
                    <button type="button" class="pdp-gallery__main-btn" data-lightbox-open="0" aria-label="View full image">
                      <img src="{{ _hero_file | image_url: width: 1400 }}" alt="{{ product.title }}" class="pdp-gallery__img" loading="eager">
                    </button>
                  </div>
                  {%- assign _slide_i = 1 -%}
                {%- endif -%}
                {%- for block in section.blocks -%}
                  {%- if block.type == 'gallery_image' and block.settings.image != blank -%}
                    <div class="pdp-gallery__slide{% if _slide_i == 0 %} is-active{% endif %}" data-slide="{{ _slide_i }}" {{ block.shopify_attributes }}>
                      <button type="button" class="pdp-gallery__main-btn" data-lightbox-open="{{ _slide_i }}" aria-label="View full image">
                        <img src="{{ block.settings.image | image_url: width: 1400 }}" alt="{{ block.settings.image.alt | default: product.title }}" class="pdp-gallery__img" loading="lazy">
                      </button>
                    </div>
                    {%- assign _slide_i = _slide_i | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- elsif product.featured_image -%}
              <div class="pdp-gallery__slide is-active">
                <button type="button" class="pdp-gallery__main-btn" data-lightbox-open="0" aria-label="View full image">
                  <img src="{{ product.featured_image | image_url: width: 1400 }}" alt="{{ product.featured_image.alt | default: product.title }}" class="pdp-gallery__img" loading="eager">
                </button>
              </div>
            {%- endif -%}
          </div>

          {%- comment -%} Thumbnail row - desktop only, below hero {%- endcomment -%}
          {%- if has_gallery and total_slides > 1 -%}
            <div class="pdp-gallery__thumbs" id="PdpThumbs">
              {%- if use_product_media and product.images.size > 0 -%}
                {%- for image in product.images -%}
                  <button type="button" class="pdp-gallery__thumb{% if forloop.first %} is-active{% endif %}" data-thumb="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}">
                    <img src="{{ image | image_url: width: 300 }}" alt="{{ image.alt | default: product.title }}" loading="lazy">
                  </button>
                {%- endfor -%}
              {%- else -%}
                {%- assign _thumb_i = 0 -%}
                {%- if _hero_file != blank -%}
                  <button type="button" class="pdp-gallery__thumb is-active" data-thumb="0" aria-label="View image 1">
                    <img src="{{ _hero_file | image_url: width: 300 }}" alt="{{ product.title }}" loading="lazy">
                  </button>
                  {%- assign _thumb_i = 1 -%}
                {%- endif -%}
                {%- for block in section.blocks -%}
                  {%- if block.type == 'gallery_image' and block.settings.image != blank -%}
                    <button type="button" class="pdp-gallery__thumb{% if _thumb_i == 0 %} is-active{% endif %}" data-thumb="{{ _thumb_i }}" aria-label="View image {{ _thumb_i | plus: 1 }}">
                      <img src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ block.settings.image.alt | default: product.title }}" loading="lazy">
                    </button>
                    {%- assign _thumb_i = _thumb_i | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- comment -%}
            Dot navigation - mobile only. NOT aria-hidden: below 900px the thumbnail rail is
            hidden, so these dots are the only gallery navigation there. Hiding them from
            assistive tech while leaving them focusable removed gallery access entirely.
          {%- endcomment -%}
          {%- if has_gallery and total_slides > 1 -%}
            <div class="pdp-gallery__dots" id="PdpDots" role="group" aria-label="Gallery navigation">
              {%- for i in (1..total_slides) -%}
                <button type="button" class="pdp-gallery__dot{% if forloop.first %} is-active{% endif %}"
                  data-dot="{{ forloop.index0 }}"
                  aria-label="Show image {{ forloop.index }} of {{ total_slides }}"
                  {% if forloop.first %}aria-current="true"{% endif %}></button>
              {%- endfor -%}
            </div>
          {%- endif -%}

        </div>

        {%- comment -%} Lightbox overlay {%- endcomment -%}
        {%- if has_gallery -%}
          <div id="PdpLightbox" class="pdp-lightbox" aria-hidden="true" aria-modal="true" role="dialog">
            <button type="button" class="pdp-lightbox__close" data-lightbox-close aria-label="Close gallery">✕</button>
            {%- if total_slides > 1 -%}
              <button type="button" class="pdp-lightbox__prev" data-lightbox-prev aria-label="Previous image">‹</button>
              <button type="button" class="pdp-lightbox__next" data-lightbox-next aria-label="Next image">›</button>
            {%- endif -%}
            <div class="pdp-lightbox__images">
              {%- if use_product_media and product.images.size > 0 -%}
                {%- for image in product.images -%}
                  <div class="pdp-lightbox__slide{% if forloop.first %} is-active{% endif %}" data-lightbox-slide="{{ forloop.index0 }}">
                    <img src="{{ image | image_url: width: 2000 }}" alt="{{ image.alt | default: product.title }}" loading="lazy">
                  </div>
                {%- endfor -%}
              {%- else -%}
                {%- assign _lb_i = 0 -%}
                {%- if _hero_file != blank -%}
                  <div class="pdp-lightbox__slide is-active" data-lightbox-slide="0">
                    <img src="{{ _hero_file | image_url: width: 2000 }}" alt="{{ product.title }}" loading="lazy">
                  </div>
                  {%- assign _lb_i = 1 -%}
                {%- endif -%}
                {%- for block in section.blocks -%}
                  {%- if block.type == 'gallery_image' and block.settings.image != blank -%}
                    <div class="pdp-lightbox__slide{% if _lb_i == 0 %} is-active{% endif %}" data-lightbox-slide="{{ _lb_i }}">
                      <img src="{{ block.settings.image | image_url: width: 2000 }}" alt="{{ block.settings.image.alt | default: product.title }}" loading="lazy">
                    </div>
                    {%- assign _lb_i = _lb_i | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

      </div>

      {%- comment -%} ── Right: product info (sticky on desktop) ── {%- endcomment -%}
      <div class="product__info">

        {%- if product.metafields.custom.eyebrow != blank -%}
          <div class="hero__kicker" style="margin-bottom: 8px;">{{ product.metafields.custom.eyebrow }}</div>
        {%- endif -%}

        <h1 class="product__title">{{ product.title }}</h1>

        {%- comment -%}
          ── Reorderable subsections ──────────────────────────────────────────────
          Everything below the title is captured, then emitted in the order the merchant
          sets under "Info column order" in the theme editor. Captured rather than
          reordered with CSS `order` for two reasons: one order now drives BOTH desktop and
          mobile (they used to be maintained separately and had silently drifted apart —
          the benefit bullets sat above the buy form on desktop and below the cross-sell
          card on mobile), and source order is what screen readers and Tab follow, so the
          reading order always matches what's on screen.

          Order of the captures themselves is irrelevant — only the emit loop at the bottom
          of this column decides what renders where. But anything a capture DEPENDS on must
          be assigned before it: the shared variables between the ship badge and the buy
          form below are positioned there deliberately.
        {%- endcomment -%}

        {%- capture _pdp_rating -%}
        {%- if section.settings.show_rating -%}
          <div class="product__rating">
            {%- assign rating_display = section.settings.rating_value | divided_by: 10.0 -%}
            {%- assign full_stars = rating_display | floor -%}
            {%- assign star_decimal = rating_display | minus: full_stars -%}
            {%- assign has_half_star = false -%}
            {%- if star_decimal >= 0.25 -%}{%- assign has_half_star = true -%}{%- endif -%}
            {%- assign half_star_pos = full_stars | plus: 1 -%}
            <span class="product__stars" aria-label="{{ rating_display }} out of 5 stars">
              {%- for i in (1..5) -%}
                {%- if i <= full_stars -%}<span class="star star--full">★</span>
                {%- elsif i == half_star_pos and has_half_star -%}<span class="star star--half">★</span>
                {%- else -%}<span class="star star--empty">★</span>
                {%- endif -%}
              {%- endfor -%}
            </span>
            <span class="product__rating-value">{{ rating_display }}</span>
            {%- if section.settings.rating_count != blank -%}
              <span class="product__rating-count">({{ section.settings.rating_count }})</span>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- endcapture -%}

        {%- comment -%} Short tagline - above price. The full product description now renders below "What it supports". {%- endcomment -%}
        {%- capture _pdp_tagline -%}
        {%- if section.settings.tagline != blank -%}
          <p class="product__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}
        {%- endcapture -%}

        {%- comment -%} Visible feature list - coloured dot bullets (Billie PDP format) {%- endcomment -%}
        {%- capture _pdp_benefits -%}
        {%- assign _has_benefits = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}{%- assign _has_benefits = true -%}{%- endif -%}
        {%- endfor -%}
        {%- if _has_benefits -%}
          <ul class="product__features">
            {%- for block in section.blocks -%}
              {%- if block.type == 'benefit' -%}
                <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- endcapture -%}

        {%- capture _pdp_ship -%}
        {%- if section.settings.show_ship_badge or settings.show_ship_badge -%}
          <div class="product__ship-badge">
            <span aria-hidden="true">●</span> {{ settings.ship_badge_text }}
          </div>
        {%- endif -%}
        {%- endcapture -%}

        {%- comment -%}
          Shared buy-block variables. These MUST stay ahead of the _pdp_buy capture below —
          a capture runs its contents at the point it appears, not where it's emitted.
        {%- endcomment -%}
        {%- assign _first_selling_plan = nil -%}
        {%- for group in product.selling_plan_groups -%}
          {%- for plan in group.selling_plans -%}
            {%- if _first_selling_plan == nil -%}
              {%- assign _first_selling_plan = plan -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}

        {%- comment -%}
          Gold Subscription (free gift, exclusive perks) is limited to these products;
          everything else gets a plain Subscribe & Save. The "Show founding offer" setting
          then lets a single product opt out from the theme editor without editing this list.

          _show_gold_offer gates BOTH the offer box and the "free gift" wording in the
          Subscribe & Save option, so a page can never promise a gift it doesn't show.
        {%- endcomment -%}
        {%- assign _offer_handles = 'creatine-monohydrate,creatine-hydration-powder,colostrum-powder' | split: ',' -%}
        {%- assign _is_gold_product = false -%}
        {%- if _offer_handles contains product.handle -%}
          {%- assign _is_gold_product = true -%}
        {%- endif -%}
        {%- assign _show_gold_offer = false -%}
        {%- if _is_gold_product and section.settings.show_founding_offer -%}
          {%- assign _show_gold_offer = true -%}
        {%- endif -%}

        {%- comment -%}
          Buyability: on-demand / continue-selling variants (e.g. Supliful-fulfilled) stay
          purchasable even at 0 stock. Shopify reports variant.available = false for a
          fulfillment-service item at 0, so we also honor the continue-selling policy.
        {%- endcomment -%}
        {%- assign _sel_variant = product.selected_or_first_available_variant -%}
        {%- assign _atc_available = _sel_variant.available -%}
        {%- if _sel_variant.inventory_policy == 'continue' -%}{%- assign _atc_available = true -%}{%- endif -%}

        {%- capture _pdp_buy -%}
        <form data-product-form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" novalidate>
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="selling_plan" id="SellingPlanInput" value="">

          {%- if product.variants.size > 1 -%}
            {%- for option in product.options_with_values -%}
              {%- assign option_index = forloop.index0 -%}
              <div class="product__variant-group">
                <div class="product__variant-label">{{ option.name }}</div>
                <div class="product__variant-options">
                  {%- for value in option.values -%}
                    {%- assign variant_for_value = nil -%}
                    {%- for v in product.variants -%}
                      {%- if v.options[option_index] == value -%}
                        {%- assign variant_for_value = v -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if variant_for_value -%}
                      <button type="button" class="product__variant-option"
                        data-variant-option
                        data-variant-id="{{ variant_for_value.id }}"
                        data-selected="{% if variant_for_value.id == product.selected_or_first_available_variant.id %}true{% else %}false{% endif %}">
                        {{ value }}
                      </button>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}

          {%- comment -%} Trust line - before price so it's seen before cost {%- endcomment -%}
          {%- if section.settings.trust_line != blank -%}
            <p class="product__trust-line product__trust-line--top">{{ section.settings.trust_line }}</p>
          {%- endif -%}

          {%- assign sub_price = product.selected_or_first_available_variant.price | times: 0.85 | round -%}
          {%- assign _default_plan_id = '' -%}
          {%- for _alloc in product.selected_or_first_available_variant.selling_plan_allocations -%}
            {%- assign _default_plan_id = _alloc.selling_plan.id -%}
            {%- break -%}
          {%- endfor -%}

          {%- comment -%}
            Purchase-option selector - shown when the product has a subscription selling plan.
            Subscribe is the default; the controller script (below) swaps the hidden selling_plan
            value, price emphasis, benefits, and the Gold Jar offer block between modes.
            NOTE: designed for single-variant subscription products (Creatine, Hydration). A
            multi-variant product with a selling plan would also need variant-change handling.
          {%- endcomment -%}
          {%- if _first_selling_plan != nil and _default_plan_id != blank -%}
            <div class="purchase-options" data-purchase-options data-plan-id="{{ _default_plan_id }}">
              <button type="button" class="purchase-option is-selected" data-purchase-option data-mode="subscribe" aria-pressed="true">
                <span class="purchase-option__radio" aria-hidden="true"></span>
                <span class="purchase-option__body">
                  <span class="purchase-option__title">Subscribe &amp; Save <span class="purchase-option__tag">Most popular</span></span>
                  {%- comment -%}
                    Keep this note to one short line. The founding offer itself is described
                    once, in the gold-jar-offer block below - not repeated here.
                  {%- endcomment -%}
                  {%- if _show_gold_offer -%}
                    <span class="purchase-option__note">Save 15% + free gift with purchase</span>
                  {%- else -%}
                    <span class="purchase-option__note">Save 15% · cancel anytime</span>
                  {%- endif -%}
                </span>
                <span class="purchase-option__price"><del>{{ product.selected_or_first_available_variant.price | money }}</del> {{ sub_price | money }}<span class="purchase-option__per">/mo</span></span>
              </button>
              <button type="button" class="purchase-option" data-purchase-option data-mode="onetime" aria-pressed="false">
                <span class="purchase-option__radio" aria-hidden="true"></span>
                <span class="purchase-option__body">
                  <span class="purchase-option__title">One-time purchase</span>
                </span>
                <span class="purchase-option__price">{{ product.selected_or_first_available_variant.price | money }}</span>
              </button>
            </div>

          {%- else -%}
            <div class="product__price" data-product-price>
              {{ product.selected_or_first_available_variant.price | money }}
            </div>
          {%- endif -%}

          {%- if section.settings.show_gift_banner -%}
            <div class="gift-banner">
              <span class="gift-banner__icon">✦</span>
              <span>{{ section.settings.gift_banner_text }}</span>
            </div>
          {%- endif -%}

          {%- comment -%}
            Founding offer - gold subscription products, unless switched off for this
            template via "Show founding offer" in the theme editor. Hiding it also stops the
            free gift being added to the cart, which is the intended behaviour: the gold lid
            only fits the creatine jars.
          {%- endcomment -%}
          {%- if _show_gold_offer -%}
            {%- render 'gold-jar-offer' -%}
          {%- endif -%}

          {%- comment -%}
            Buy row: quantity and Add to Cart sit side by side on mobile so the primary CTA
            stays within a thumb's reach of the price instead of a stepper-height below it.
          {%- endcomment -%}
          <div class="product__buy">
            <div class="product__qty-row">
              <div class="stepper" data-quantity-stepper>
                <button type="button" data-qty-down aria-label="Decrease">−</button>
                <input class="stepper__value" type="number" name="quantity" value="1" min="1" max="99" readonly>
                <button type="button" data-qty-up aria-label="Increase">+</button>
              </div>
            </div>

            <div class="product__atc-row">
              <button type="submit" class="btn btn--primary product__atc" data-product-submit data-default-label="Add to Cart"
                {% unless _atc_available %}disabled{% endunless %}>
                {% if _atc_available %}
                  Add to Cart
                {% else %}
                  {{ 'general.product.sold_out' | t }}
                {% endif %}
              </button>
            </div>
          </div>

          {%- if section.settings.show_dynamic_checkout -%}
            <div class="product__dynamic-checkout" data-dynamic-checkout>
              <div class="product__or-divider">or</div>
              {{ form | payment_button }}
            </div>
          {%- endif -%}

          {%- comment -%} Secondary action - de-emphasised so it never competes with Add to Cart. {%- endcomment -%}
          {%- if section.settings.show_expert_modal -%}
            <div class="product__secondary-actions">
              <button type="button" class="product__expert-btn" data-expert-modal-open>{{ section.settings.expert_button_label }}</button>
            </div>
          {%- endif -%}

          {%- comment -%} Subscription is now handled by the purchase-option toggle above the price. {%- endcomment -%}

        </form>
        {%- endcapture -%}

        {%- comment -%}
          ── Cross-sell: one-tap add for the paired product (Creatine ↔ Hydration) ──
          Defaults to sitting immediately under the buy block so it's visible without
          scrolling past the fold; the cs_layout_* params below are the theme-editor
          controls for arranging the pieces inside the card itself.
        {%- endcomment -%}
        {%- capture _pdp_pair -%}
        {%- assign _cs = section.settings.crosssell_product -%}
        {%- if _cs != blank and _cs.handle != product.handle -%}
          {%- render 'pdp-cross-sell',
              cs_product: _cs,
              cs_eyebrow: section.settings.crosssell_eyebrow,
              cs_note: section.settings.crosssell_note,
              cs_image_position: section.settings.crosssell_image_position,
              cs_button_position: section.settings.crosssell_button_position,
              cs_align: section.settings.crosssell_align,
              cs_image_size: section.settings.crosssell_image_size,
              cs_order_name: section.settings.crosssell_order_name,
              cs_order_note: section.settings.crosssell_order_note,
              cs_order_price: section.settings.crosssell_order_price -%}
        {%- endif -%}
        {%- endcapture -%}

        {%- capture _pdp_details -%}
        <hr class="product__divider">

        {%- comment -%} What it supports accordion {%- endcomment -%}
        {%- assign _has_support = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'support_item' -%}{%- assign _has_support = true -%}{%- endif -%}
        {%- endfor -%}
        {%- if _has_support -%}
          <div class="product__accordion" data-accordion>
            <button type="button" class="product__accordion__btn" aria-expanded="false" aria-controls="acc-supports">
              <span>{{ section.settings.supports_heading | default: 'What it supports' }}</span>
              <span class="product__accordion__icon" aria-hidden="true">+</span>
            </button>
            <div class="product__accordion__body" id="acc-supports" hidden>
              <ul class="product__acc-list">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'support_item' -%}
                    <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          </div>
        {%- endif -%}

        {%- comment -%}
          Full product details (Supliful description). Collapsed into an accordion so the long
          copy doesn't sit between the buy block and the rest of the page on mobile.
        {%- endcomment -%}
        {%- if product.description != blank -%}
          <div class="product__accordion product__details-section" data-accordion>
            <button type="button" class="product__accordion__btn" aria-expanded="false" aria-controls="acc-details">
              <span>Details</span>
              <span class="product__accordion__icon" aria-hidden="true">+</span>
            </button>
            <div class="product__accordion__body" id="acc-details" hidden>
              <div class="product__details rte">{{ product.description }}</div>
            </div>
          </div>
          <style>
            .product__details { font-size: 15px; line-height: 1.7; opacity: 0.9; }
            .product__details p { margin: 0 0 1em; }
            .product__details p:last-child { margin-bottom: 0; }
            .product__details strong { font-weight: 600; }
            .product__details a { color: inherit; text-decoration: underline; }
            .product__details img { height: 3.5rem; width: auto; margin: 8px 8px 0 0; display: inline-block; }
          </style>
        {%- endif -%}

        {%- comment -%} Ingredients accordion {%- endcomment -%}
        {%- if product.metafields.custom.ingredients.value -%}
          <div class="product__accordion" data-accordion>
            <button type="button" class="product__accordion__btn" aria-expanded="false" aria-controls="acc-ingredients">
              <span>Ingredients</span>
              <span class="product__accordion__icon" aria-hidden="true">+</span>
            </button>
            <div class="product__accordion__body" id="acc-ingredients" hidden>
              <div class="product__ingredients-list">
                {%- for ing in product.metafields.custom.ingredients.value -%}
                  <div class="product__ingredient">
                    <span>{{ ing.name }}</span>
                    <span>{{ ing.amount }}</span>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          </div>
        {%- endif -%}
        {%- endcapture -%}

        {%- comment -%}
          ── Emit the subsections in the merchant's order ──
          `| plus: 0` turns each select's string value into a number so it compares against
          the loop counter. Two subsections set to the same slot both render there, in the
          fixed order below — no subsection can be lost, whatever the settings say.
        {%- endcomment -%}
        {%- assign _o_rating   = section.settings.order_rating   | plus: 0 -%}
        {%- assign _o_tagline  = section.settings.order_tagline  | plus: 0 -%}
        {%- assign _o_benefits = section.settings.order_benefits | plus: 0 -%}
        {%- assign _o_ship     = section.settings.order_ship     | plus: 0 -%}
        {%- assign _o_buy      = section.settings.order_buy      | plus: 0 -%}
        {%- assign _o_pair     = section.settings.order_pair     | plus: 0 -%}
        {%- assign _o_details  = section.settings.order_details  | plus: 0 -%}

        {%- for _pos in (1..7) -%}
          {%- if _o_rating   == _pos -%}{{ _pdp_rating }}{%- endif -%}
          {%- if _o_tagline  == _pos -%}{{ _pdp_tagline }}{%- endif -%}
          {%- if _o_benefits == _pos -%}{{ _pdp_benefits }}{%- endif -%}
          {%- if _o_ship     == _pos -%}{{ _pdp_ship }}{%- endif -%}
          {%- if _o_buy      == _pos -%}{{ _pdp_buy }}{%- endif -%}
          {%- if _o_pair     == _pos -%}{{ _pdp_pair }}{%- endif -%}
          {%- if _o_details  == _pos -%}{{ _pdp_details }}{%- endif -%}
        {%- endfor -%}

      </div>
    </div>
  </div>

  <script>
    window.__productVariants = window.__productVariants || {};
    {%- for v in product.variants -%}
      {%- assign _v_plan_id = '' -%}
      {%- for _va in v.selling_plan_allocations -%}{%- assign _v_plan_id = _va.selling_plan.id -%}{%- break -%}{%- endfor -%}
      {%- assign _v_media_index = -1 -%}
      {%- if v.featured_image -%}
        {%- for _img in product.images -%}
          {%- if _img.id == v.featured_image.id -%}{%- assign _v_media_index = forloop.index0 -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      window.__productVariants["{{ v.id }}"] = {
        id: {{ v.id }},
        price: {{ v.price }},
        available: {% if v.available or v.inventory_policy == 'continue' %}true{% else %}false{% endif %},
        title: {{ v.title | json }},
        sellingPlanId: {% if _v_plan_id != blank %}"{{ _v_plan_id }}"{% else %}null{% endif %},
        mediaIndex: {{ _v_media_index }}
      };
    {%- endfor -%}
  </script>

  {%- comment -%}
    ── Sticky buy bar - slides up once the main ATC scrolls out of view ──
    Always buys THIS product: it mirrors the selected purchase option (subscribe vs one-time)
    and clicks the real form button, so the CTA is never more than a thumb away no matter how
    far down the page a visitor is. Cross-sell lives in its own card under the buy block.
  {%- endcomment -%}
  <div class="pdp-sticky-bar" id="PdpStickyBar">
    <div class="pdp-sticky-bar__inner container">
      <div class="pdp-sticky-bar__left">
        <div class="pdp-sticky-bar__name">{{ product.title }}</div>
        <div class="pdp-sticky-bar__price" data-sticky-price
          data-price-onetime="{{ product.selected_or_first_available_variant.price | money }}"
          data-price-subscribe="{{ sub_price | money }}">
          {{ product.selected_or_first_available_variant.price | money }}
        </div>
      </div>
      <div class="pdp-sticky-bar__actions">
        <button type="button" class="btn btn--primary pdp-sticky-bar__atc" data-sticky-atc
          {% unless _atc_available %}disabled{% endunless %}>
          {%- if _atc_available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
        </button>
      </div>
    </div>
  </div>

  {%- comment -%} ── Talk to an expert modal ── {%- endcomment -%}
  <div id="ExpertModal" class="expert-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="ExpertModalTitle">
    <div class="expert-modal__overlay" data-expert-modal-close></div>
    <div class="expert-modal__dialog">
      <button type="button" class="expert-modal__close" data-expert-modal-close aria-label="Close">&#x2715;</button>
      <p class="expert-modal__eyebrow">One of our experts will email you</p>
      <h2 class="expert-modal__headline" id="ExpertModalTitle">Talk to an expert</h2>
      <p class="expert-modal__subtext">Not sure which supplement is right for you? Leave your email and we'll follow up with a few questions so we can point you in the right direction.</p>
      <form class="expert-modal__form" id="ExpertModalForm" action="/contact" method="post" accept-charset="UTF-8">
        <input type="hidden" name="form_type" value="contact">
        <input type="hidden" name="utf8" value="&#x2713;">
        <input type="hidden" name="contact[product]" value="{{ product.title }}">
        {%- comment -%}
          contact[email] is REQUIRED by Shopify's contact form - without it the submission is
          rejected. Keep the form to name + email; the qualifying questions (what they're
          taking, what has and hasn't worked) go out in the automated reply from the inbox.
        {%- endcomment -%}
        <div class="expert-modal__field">
          <label for="ExpertName">First name</label>
          <input type="text" id="ExpertName" name="contact[name]" placeholder="Jane" required autocomplete="given-name">
        </div>
        <div class="expert-modal__field">
          <label for="ExpertEmail">Email</label>
          <input type="email" id="ExpertEmail" name="contact[email]" placeholder="jane@email.com" required autocomplete="email" inputmode="email">
        </div>
        {%- comment -%}
          Unchecked by default. Ticking it is what lets the automated follow-up reach them:
          the JS also submits a form_type=customer signup tagged "expert-request", and Shopify
          Flow triggers on that tag (wait 10 minutes, then send). Shopify Email will not send
          to an unsubscribed contact, so leads who leave this unticked get a manual reply from
          the contact-form notification instead - they are still captured either way.
        {%- endcomment -%}
        <label class="expert-modal__optin">
          <input type="checkbox" id="ExpertOptIn" name="contact[opt_in]" value="yes">
          <span>Email me the follow-up questions, plus OLNIAN tips and offers. Unsubscribe anytime.</span>
        </label>
        <button type="submit" class="btn btn--primary expert-modal__submit">Send</button>
        <p class="expert-modal__error" hidden role="alert">That didn't go through. Please check your email address and try again, or write to us at {{ shop.email }}.</p>
      </form>
      <div class="expert-modal__success" hidden>
        <p>Got it! Check your inbox — we'll be in touch shortly.</p>
      </div>
    </div>
  </div>

  {%- if _first_selling_plan != nil and _default_plan_id != blank -%}
    <style>
      .purchase-options { display: flex; flex-direction: column; gap: 10px; margin: 14px 0 4px; }
      .purchase-option {
        display: flex; align-items: center; gap: 12px; width: 100%; text-align: left;
        padding: 14px 16px; border: 1.5px solid #E2D9C8; border-radius: 14px;
        background: #fff; cursor: pointer; font: inherit; color: inherit;
        transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
      }
      .purchase-option.is-selected {
        border-color: #C9A55E;
        background: linear-gradient(180deg, #FFFDF8 0%, #FFF6F4 100%);
        box-shadow: 0 0 0 3px rgba(201,165,94,.15);
      }
      .purchase-option:focus-visible { outline: 2px solid #C9A55E; outline-offset: 2px; }
      .purchase-option__radio { flex: 0 0 auto; width: 18px; height: 18px; border-radius: 50%; border: 2px solid #C7BBA3; position: relative; }
      .purchase-option.is-selected .purchase-option__radio { border-color: #C9A55E; }
      .purchase-option.is-selected .purchase-option__radio::after { content: ""; position: absolute; inset: 3px; border-radius: 50%; background: #C9A55E; }
      .purchase-option__body { flex: 1 1 auto; display: flex; flex-direction: column; gap: 2px; }
      .purchase-option__title { font-weight: 600; font-size: 15px; color: #241F1B; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
      .purchase-option__tag { font-size: 10px; letter-spacing: .08em; text-transform: uppercase; font-weight: 700; color: #A87D3B; background: #F3EAD6; padding: 2px 7px; border-radius: 999px; }
      .purchase-option__note { font-size: 12.5px; color: #6E6459; }
      .purchase-option__price { flex: 0 0 auto; font-weight: 600; font-size: 15px; color: #241F1B; white-space: nowrap; }
      .purchase-option__price del { color: #A79C8B; font-weight: 400; margin-right: 4px; }
      .purchase-option__per { font-size: 12px; color: #6E6459; font-weight: 500; }
    </style>
    <script>
      (function () {
        var toggle = document.querySelector('[data-purchase-options]');
        if (!toggle) return;
        var planId = toggle.getAttribute('data-plan-id');
        var form = document.querySelector('[data-product-form]');
        var spInput = form && form.querySelector('[name="selling_plan"]');
        var subBadge = document.querySelector('[data-sub-badge]');
        var offer = document.querySelector('.gold-offer');
        var dynamicCheckout = form && form.querySelector('[data-dynamic-checkout]');
        var stickyPrice = document.querySelector('[data-sticky-price]');
        var opts = Array.prototype.slice.call(toggle.querySelectorAll('[data-purchase-option]'));

        function select(mode) {
          var subscribe = mode === 'subscribe';
          opts.forEach(function (o) {
            var on = o.getAttribute('data-mode') === mode;
            o.classList.toggle('is-selected', on);
            o.setAttribute('aria-pressed', on ? 'true' : 'false');
          });
          if (spInput) spInput.value = subscribe ? planId : '';
          if (subBadge) subBadge.hidden = !subscribe;
          if (offer) offer.style.display = subscribe ? '' : 'none';
          // Express checkout (Shop Pay) can't carry a subscription, so only show it for one-time.
          if (dynamicCheckout) dynamicCheckout.hidden = subscribe;
          // Keep the sticky bar honest about what the button will actually charge.
          if (stickyPrice) {
            stickyPrice.innerHTML = subscribe
              ? stickyPrice.getAttribute('data-price-subscribe') + '<span class="pdp-sticky-bar__per">/mo</span>'
              : stickyPrice.getAttribute('data-price-onetime');
          }
        }

        opts.forEach(function (o) {
          o.addEventListener('click', function () { select(o.getAttribute('data-mode')); });
        });

        // Default to Subscribe on load.
        select('subscribe');
      })();
    </script>
  {%- endif -%}

</section>

{% schema %}
{
  "name": "Product - main",
  "blocks": [
    {
      "type": "gallery_image",
      "name": "Gallery image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    },
    {
      "type": "benefit",
      "name": "Benefit pill",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji or symbol)", "default": "○" },
        { "type": "text", "id": "text", "label": "Benefit text", "default": "One ingredient" }
      ]
    },
    {
      "type": "support_item",
      "name": "What it supports",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Support text", "default": "Cognitive clarity and reaction time" }
      ]
    }
  ],
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "background_image", "label": "Product page background image" },
    { "type": "select", "id": "background_image_size", "label": "Background image size", "default": "cover", "options": [
      { "value": "cover", "label": "Cover" },
      { "value": "contain", "label": "Show full image" }
    ]},
    { "type": "select", "id": "background_image_position", "label": "Background image position", "default": "center center", "options": [
      { "value": "center center", "label": "Center" },
      { "value": "center top", "label": "Top" },
      { "value": "center bottom", "label": "Bottom" },
      { "value": "left center", "label": "Left" },
      { "value": "right center", "label": "Right" }
    ]},
    { "type": "header", "content": "Gallery" },
    { "type": "checkbox", "id": "use_product_media", "label": "Use Shopify product media", "default": true, "info": "Recommended. Pulls images from the product admin so each product page has its own gallery. Turn off only for a custom template-specific gallery." },
    { "type": "image_picker", "id": "hero_image", "label": "Fallback / template hero image" },
    { "type": "header", "content": "Rating" },
    { "type": "checkbox", "id": "show_rating", "label": "Show star rating", "default": true },
    { "type": "range", "id": "rating_value", "label": "Rating (×10, so 48 = 4.8)", "min": 10, "max": 50, "step": 1, "default": 48, "info": "Divide by 10 for display value" },
    { "type": "text", "id": "rating_count", "label": "Review count label", "default": "142 reviews" },
    { "type": "header", "content": "Tagline (above price)" },
    { "type": "textarea", "id": "tagline", "label": "Short tagline", "default": "One ingredient. Clinically studied in women for cognitive clarity, muscle recovery, and mood stability. Third-party tested every batch." },
    { "type": "header", "content": "Benefits accordion" },
    { "type": "text", "id": "benefits_heading", "label": "Benefits heading", "default": "Benefits" },
    { "type": "header", "content": "What it supports accordion" },
    { "type": "text", "id": "supports_heading", "label": "Supports heading", "default": "What it supports" },
    { "type": "header", "content": "Purchase controls" },
    { "type": "text", "id": "trust_line", "label": "Trust line", "default": "Third-party tested · Free shipping over $50 · Cancel anytime" },
    { "type": "text", "id": "atc_label", "label": "Add-to-cart label", "default": "Start Now" },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout button", "default": true },
    { "type": "checkbox", "id": "show_subscription_card", "label": "Show subscription card", "default": true },
    { "type": "checkbox", "id": "show_expert_modal", "label": "Show expert modal", "default": true },
    { "type": "text", "id": "expert_button_label", "label": "Expert button label", "default": "Talk to an expert" },
    { "type": "header", "content": "Founding offer" },
    { "type": "checkbox", "id": "show_founding_offer", "label": "Show founding offer box", "default": true, "info": "The \"Join the Gold Subscription\" box under the price. Only ever shows on Premium Creatine, Creatine Hydration and Colostrum. Turning it off also removes the \"free gift with purchase\" line from Subscribe & Save, and stops the free gift being added to the cart." },
    { "type": "header", "content": "Gift banner" },
    { "type": "checkbox", "id": "show_gift_banner", "label": "Show gift banner", "default": true },
    { "type": "text", "id": "gift_banner_text", "label": "Gift banner text", "default": "First subscription includes the keepsake gold lid and signature pink scoop." },
    { "type": "header", "content": "Info column order", "info": "Position of each block down the right-hand column, top to bottom. The same order is used on desktop and mobile. The eyebrow and product title are always first." },
    { "type": "select", "id": "order_rating", "label": "Star rating", "default": "1",
      "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }, { "value": "6", "label": "6" }, { "value": "7", "label": "7" } ] },
    { "type": "select", "id": "order_tagline", "label": "Tagline", "default": "2",
      "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }, { "value": "6", "label": "6" }, { "value": "7", "label": "7" } ] },
    { "type": "select", "id": "order_benefits", "label": "Benefit bullets", "default": "3", "info": "The orange dot list.",
      "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }, { "value": "6", "label": "6" }, { "value": "7", "label": "7" } ] },
    { "type": "select", "id": "order_ship", "label": "Free shipping badge", "default": "4",
      "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }, { "value": "6", "label": "6" }, { "value": "7", "label": "7" } ] },
    { "type": "select", "id": "order_buy", "label": "Purchase options + Add to Cart", "default": "5",
      "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }, { "value": "6", "label": "6" }, { "value": "7", "label": "7" } ] },
    { "type": "select", "id": "order_pair", "label": "\"Pairs with\" card", "default": "6",
      "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }, { "value": "6", "label": "6" }, { "value": "7", "label": "7" } ] },
    { "type": "select", "id": "order_details", "label": "Details accordions", "default": "7", "info": "What it supports / Details / Ingredients, with the divider above them.",
      "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }, { "value": "6", "label": "6" }, { "value": "7", "label": "7" } ] },
    { "type": "header", "content": "Cross-sell card (under Add to Cart)" },
    { "type": "product", "id": "crosssell_product", "label": "Cross-sell product", "info": "Shown as a one-tap \"Add\" card directly under the buy block, e.g. Creatine ↔ Hydration. Leave empty to hide. The sticky bar always buys the current product." },
    { "type": "text", "id": "crosssell_eyebrow", "label": "Cross-sell label", "default": "Pairs with" },
    { "type": "text", "id": "crosssell_note", "label": "Cross-sell one-liner", "info": "One short reason to add it. Falls back to the product's subtitle metafield." },
    { "type": "header", "content": "Cross-sell card layout", "info": "Arranges the pieces inside the \"Pairs with\" card." },
    { "type": "select", "id": "crosssell_image_position", "label": "Product image", "default": "left",
      "options": [ { "value": "left", "label": "Left of the text" }, { "value": "right", "label": "Right of the text" } ] },
    { "type": "select", "id": "crosssell_button_position", "label": "Add button", "default": "inline",
      "options": [ { "value": "inline", "label": "Beside the text" }, { "value": "below", "label": "Full width, below" } ] },
    { "type": "select", "id": "crosssell_align", "label": "Vertical alignment", "default": "center",
      "options": [ { "value": "center", "label": "Middle" }, { "value": "top", "label": "Top" } ] },
    { "type": "range", "id": "crosssell_image_size", "label": "Image size", "min": 40, "max": 96, "step": 4, "unit": "px", "default": 56 },
    { "type": "select", "id": "crosssell_order_name", "label": "Text order: product name", "default": "1",
      "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" } ] },
    { "type": "select", "id": "crosssell_order_note", "label": "Text order: one-liner", "default": "2",
      "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" } ] },
    { "type": "select", "id": "crosssell_order_price", "label": "Text order: price", "default": "3",
      "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" } ] },
    { "type": "header", "content": "Bundle + Save card" },
    { "type": "checkbox", "id": "show_bundle_upsell", "label": "Show bundle card", "default": true },
    { "type": "text", "id": "bundle_upsell_headline", "label": "Headline (e.g. Bundle + Save 25%)", "default": "Bundle + Save 25%" },
    { "type": "textarea", "id": "bundle_upsell_body", "label": "Description", "default": "Add Magnesium Glycinate to your routine and save on your first order." },
    { "type": "text", "id": "bundle_sale_price", "label": "Sale price (text, e.g. $67.48)" },
    { "type": "text", "id": "bundle_compare_price", "label": "Compare-at price (text, e.g. $89.98)" },
    { "type": "text", "id": "bundle_image_filename", "label": "Bundle product image (asset filename)" },
    { "type": "url", "id": "bundle_upsell_link", "label": "Bundle link" }
  ]
}
{% endschema %}
