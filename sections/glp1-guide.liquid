{% liquid
  assign offer_active = false
  assign offer_code = section.settings.discount_code | strip
  if section.settings.offer_enabled and offer_code != blank and section.settings.discount_percent > 0
    assign offer_active = true
  endif
  if customer and customer.orders_count > 0
    assign offer_active = false
  endif
  assign return_url = routes.cart_url
  if offer_active
    assign encoded_code = offer_code | url_encode
    assign return_url = routes.root_url | append: 'discount/' | append: encoded_code | append: '?redirect=' | append: routes.cart_url
  endif
  assign review_count = 0
  for block in section.blocks
    if block.type == 'testimonial' and block.settings.quote != blank and block.settings.author != blank
      assign review_count = review_count | plus: 1
    endif
  endfor
%}
<div class="glg" id="Guide-{{ section.id }}">
  <div class="glg-welcome"><button type="button" data-email-open aria-haspopup="dialog" aria-controls="GuideEmail-{{ section.id }}">{{ 'glp1_guide.email.trigger' | t }} <span aria-hidden="true">↗</span></button></div>
  <header class="glg-nav glg-wrap">
    <a class="glg-logo" href="{{ routes.root_url }}" aria-label="{{ 'glp1_guide.nav.home' | t }}">{{ 'glp1_guide.nav.brand' | t }}</a>
    <nav aria-label="{{ 'glp1_guide.nav.label' | t }}">
      <a href="#GuideLearn-{{ section.id }}">{{ 'glp1_guide.nav.learn' | t }}</a>
      <a href="#GuideFormula-{{ section.id }}">{{ 'glp1_guide.nav.formula' | t }}</a>
    </nav>
    <a class="glg-nav-cta" href="#GuideOffer-{{ section.id }}">{{ 'glp1_guide.nav.shop' | t }} <span aria-hidden="true">↗</span></a>
  </header>
  <section class="glg-hero glg-wrap" aria-labelledby="GuideHeading-{{ section.id }}"><div class="glg-hero-copy"><p class="glg-eyebrow">{{ 'glp1_guide.hero.eyebrow' | t }}</p><h1 id="GuideHeading-{{ section.id }}">{% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}{{ 'glp1_guide.hero.heading' | t }}{% endif %}</h1><p class="glg-hero-lead">{{ 'glp1_guide.hero.body' | t }}</p></div></section>
  <section class="glg-tree glg-space glg-wrap" id="GuideFit-{{ section.id }}" aria-labelledby="GuideFitTitle-{{ section.id }}">
    <h2 class="visually-hidden" id="GuideFitTitle-{{ section.id }}">{{ 'glp1_guide.tree.heading' | t }}</h2>
    <div class="glg-tree-interactive" hidden data-tree>
      <div class="glg-tree-choices" role="group" aria-label="{{ 'glp1_guide.tree.heading' | t }}">
        {% assign concerns = 'nutrition,digestion,energy,routine' | split: ',' %}
        {% for concern in concerns %}{% assign concern_key = 'glp1_guide.tree.' | append: concern %}
          {% assign image_key = concern | append: '_image' %}
          <button type="button" data-tree-choice="{{ concern }}" aria-controls="GuideTreeResult-{{ section.id }}" aria-pressed="false">{% if section.settings[image_key] != blank %}{{ section.settings[image_key] | image_url: width: 800 | image_tag: widths: '240, 400, 600, 800', sizes: '(min-width: 750px) 23vw, 46vw', loading: 'eager', alt: '' }}{% endif %}<span class="glg-card-copy">{{ concern_key | t }}</span><span class="glg-tree-arrow" aria-hidden="true">↗</span></button>
        {% endfor %}
      </div>
      <div class="glg-tree-connector" aria-hidden="true"></div>
      <div class="glg-tree-result" id="GuideTreeResult-{{ section.id }}" data-tree-result aria-live="polite" aria-atomic="true"><div class="glg-tree-placeholder"><span aria-hidden="true">↓</span><h3>{{ 'glp1_guide.tree.prompt' | t }}</h3><p>{{ 'glp1_guide.tree.hint' | t }}</p></div></div>
      <div class="glg-tree-more" data-tree-more hidden><p>{{ 'glp1_guide.tree.other' | t }}</p><div role="group" aria-label="{{ 'glp1_guide.tree.other' | t }}"><button type="button" data-tree-choice="nutrition" aria-controls="GuideTreeResult-{{ section.id }}" aria-pressed="false">{{ 'glp1_guide.tree.nutrition_short' | t }} ↗</button><button type="button" data-tree-choice="digestion" aria-controls="GuideTreeResult-{{ section.id }}" aria-pressed="false">{{ 'glp1_guide.tree.digestion_short' | t }} ↗</button><button type="button" data-tree-choice="energy" aria-controls="GuideTreeResult-{{ section.id }}" aria-pressed="false">{{ 'glp1_guide.tree.energy_short' | t }} ↗</button><button type="button" data-tree-choice="routine" aria-controls="GuideTreeResult-{{ section.id }}" aria-pressed="false">{{ 'glp1_guide.tree.routine_short' | t }} ↗</button></div></div>
    </div>
    {% assign paths = 'nutrition,digestion,energy,routine' | split: ',' %}{% for path in paths %}
      {% assign title_key = 'glp1_guide.tree.' | append: path | append: '_title' %}{% assign body_key = 'glp1_guide.tree.' | append: path | append: '_body' %}{% assign limit_key = 'glp1_guide.tree.' | append: path | append: '_limit' %}{% assign source_key = 'glp1_guide.tree.' | append: path | append: '_source' %}
      <template data-tree-template="{{ path }}"><div class="glg-tree-answer"><div><p class="glg-eyebrow">{{ 'glp1_guide.tree.result_label' | t }}</p><h3 tabindex="-1">{{ title_key | t }}</h3><p class="glg-body">{{ body_key | t }}</p><a class="glg-text-link" href="#GuideFormula-{{ section.id }}">{{ 'glp1_guide.tree.why' | t }} ↗</a></div><aside><p class="glg-eyebrow">{{ 'glp1_guide.tree.limit_label' | t }}</p><p>{{ limit_key | t }}</p><a class="glg-text-link" href="{{ source_key | t }}" target="_blank" rel="noopener">{{ 'glp1_guide.tree.source' | t }} ↗</a></aside></div></template>
    {% endfor %}
    <noscript><p class="glg-body">{{ 'glp1_guide.tree.nojs' | t }}</p></noscript><p class="glg-fine glg-tree-scope">{{ 'glp1_guide.tree.scope' | t }}</p>
  </section>
  <section class="glg-learn glg-space" id="GuideLearn-{{ section.id }}" aria-labelledby="GuideLearnTitle-{{ section.id }}">
    <div class="glg-wrap">
      <div class="glg-split">
        <div>
          <p class="glg-eyebrow">{{ 'glp1_guide.learn.eyebrow' | t }}</p>
          <h2 id="GuideLearnTitle-{{ section.id }}">{{ 'glp1_guide.learn.heading' | t }}</h2>
          <p class="glg-body">{{ 'glp1_guide.learn.intro' | t }}</p>
          <p class="glg-body">{{ 'glp1_guide.learn.body' | t }}</p>
        <details class="glg-details">
          <summary>{{ 'glp1_guide.science.link' | t }}<span aria-hidden="true">+</span></summary>
          <div><p>{{ 'glp1_guide.science.body' | t }}</p><ul><li><a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC12125019/" target="_blank" rel="noopener">{{ 'glp1_guide.science.study1' | t }}</a></li><li><a href="https://ods.od.nih.gov/factsheets/MVMS-Consumer/" target="_blank" rel="noopener">{{ 'glp1_guide.science.study2' | t }}</a></li></ul><p>{{ 'glp1_guide.science.limit' | t }}</p></div>
        </details>
        </div>
        {% if section.settings.lifestyle_image != blank %}
          <figure class="glg-lifestyle">{% assign lifestyle_alt = 'glp1_guide.learn.photo_alt' | t %}{{ section.settings.lifestyle_image | image_url: width: 1100 | image_tag: widths: '400, 650, 900, 1100', sizes: '(min-width: 750px) 45vw, 90vw', loading: 'lazy', alt: lifestyle_alt }}<figcaption>{{ 'glp1_guide.learn.photo_caption' | t }}</figcaption></figure>
        {% endif %}
      </div>
    </div>
  </section>
  <section class="glg-month glg-space" id="GuideFormula-{{ section.id }}" aria-labelledby="GuideFormulaTitle-{{ section.id }}">
    <div class="glg-wrap">
      <p class="glg-eyebrow">{{ 'glp1_guide.month.eyebrow' | t }}</p>
      <h2 id="GuideFormulaTitle-{{ section.id }}">{{ 'glp1_guide.month.heading' | t }}</h2>
      <p class="glg-body">{{ 'glp1_guide.month.intro' | t }}</p>
      <div class="glg-timeline">
        {% for day in (1..3) %}{% assign title_key = 'glp1_guide.month.title' | append: day %}{% assign body_key = 'glp1_guide.month.body' | append: day %}{% assign day_key = 'glp1_guide.month.day' | append: day %}
          <article><span class="glg-day">{{ day_key | t }}</span><div class="glg-progress" aria-hidden="true"><i style="width:100%"></i></div><h3>{{ title_key | t }}</h3><p>{{ body_key | t }}</p></article>
        {% endfor %}
      </div>
      <p class="glg-fine">{{ 'glp1_guide.month.science' | t }}</p>
      <div class="glg-clean"><h3>{{ 'glp1_guide.proof.heading' | t }}</h3><div>{% for item in (1..3) %}{% assign clean_key = 'glp1_guide.proof.clean' | append: item %}<p><span aria-hidden="true">✓</span> {{ clean_key | t }}</p>{% endfor %}</div></div>
      {% if section.settings.facts_image != blank %}<details class="glg-details glg-facts-disclosure"><summary>{{ 'glp1_guide.proof.facts' | t }}<span aria-hidden="true">+</span></summary><div>{% assign facts_alt = 'glp1_guide.proof.alt' | t %}{{ section.settings.facts_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: facts_alt }}</div></details>{% endif %}
    {% if review_count > 0 %}
      <div class="glg-reviews"><h3>{{ 'glp1_guide.proof.reviews' | t }}</h3><div class="glg-review-grid">{% for block in section.blocks %}{% if block.type == 'testimonial' and block.settings.quote != blank and block.settings.author != blank %}<figure {{ block.shopify_attributes }}><blockquote>{{ block.settings.quote | escape }}</blockquote><figcaption>{{ block.settings.author | escape }}</figcaption>{% if block.settings.source_url != blank %}<a class="glg-text-link" href="{{ block.settings.source_url }}">{{ block.settings.source_label | escape }}</a>{% endif %}</figure>{% endif %}{% endfor %}</div></div>
    {% endif %}    </div>
  </section>
  <section class="glg-offer glg-space" id="GuideOffer-{{ section.id }}" aria-labelledby="GuideOfferTitle-{{ section.id }}">
    <div class="glg-wrap glg-offer-grid">
      <div class="glg-offer-image">{% assign offer_image = section.settings.offer_image %}{% if offer_image != blank %}{{ offer_image | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 900px) 45vw, 90vw', loading: 'lazy', alt: 'OLNIAN GLP-1 Nutrient Support, 60 capsules' }}{% endif %}</div>
      <div class="glg-offer-copy">
        <p class="glg-eyebrow">{{ 'glp1_guide.offer.eyebrow' | t }}</p><h2 id="GuideOfferTitle-{{ section.id }}">{{ 'glp1_guide.offer.heading' | t }}</h2><p class="glg-body">{{ 'glp1_guide.offer.body' | t }}</p>
        <h3>{{ 'glp1_guide.offer.name' | t }}</h3><p class="glg-fine">{{ 'glp1_guide.offer.size' | t }}</p>
        <div data-live-offer hidden data-product-url="{{ routes.root_url }}products/glp-1-nutrient-support" data-percent="{% if offer_active %}{{ section.settings.discount_percent }}{% else %}0{% endif %}" data-currency="{{ cart.currency.iso_code | default: shop.currency }}" data-buy-label="{{ 'glp1_guide.offer.discount_button' | t }}" data-standard-label="{{ 'glp1_guide.offer.button' | t }}" data-sold-label="{{ 'glp1_guide.offer.sold_out' | t }}">
          {% if offer_active %}<p class="glg-offer-badge">{{ 'glp1_guide.offer.badge' | t: percent: section.settings.discount_percent }}</p>{% endif %}
          <div class="glg-price" aria-live="polite">{% if offer_active %}<s><span class="visually-hidden">{{ 'glp1_guide.offer.regular' | t }}</span><span data-guide-original></span></s>{% endif %}<strong><span class="visually-hidden">{{ 'glp1_guide.offer.price_label' | t }}</span><span data-guide-price></span></strong></div>
          <p class="glg-one-time">{{ 'glp1_guide.offer.one_time' | t }}</p>
          <form action="{{ routes.cart_add_url }}" method="post" class="glg-product-form">
            <input type="hidden" name="id" value="44512991608898"><input type="hidden" name="quantity" value="1"><input type="hidden" name="return_to" value="{{ return_url | escape }}">
            <button class="glg-button glg-buy" type="submit" disabled>{{ 'glp1_guide.offer.button' | t }}</button>
          </form>
          {% if offer_active %}<p class="glg-fine glg-terms">{{ 'glp1_guide.offer.terms' | t }}</p>{% endif %}
          <p class="glg-fine glg-shipping">{{ 'glp1_guide.offer.shipping' | t }}</p>
        </div>
        <p class="glg-fine glg-safety">{{ 'glp1_guide.offer.safety' | t }}</p>
        <a class="glg-text-link" data-product-fallback href="{{ routes.root_url }}products/glp-1-nutrient-support">{{ 'glp1_guide.offer.details' | t }} ↗</a>
      </div>
    </div>
  </section>
  {% assign email_form_id = 'GuideEmailForm-' | append: section.id %}
  <dialog class="glg-email-dialog" id="GuideEmail-{{ section.id }}" aria-labelledby="GuideEmailTitle-{{ section.id }}" aria-describedby="GuideEmailIntro-{{ section.id }}">
    <button type="button" class="glg-email-close" data-email-close aria-label="{{ 'glp1_guide.email.close' | t }}">×</button>
    <p class="glg-eyebrow">{{ 'glp1_guide.email.eyebrow' | t }}</p><h2 id="GuideEmailTitle-{{ section.id }}">{{ 'glp1_guide.email.heading' | t }}</h2><p class="glg-body" id="GuideEmailIntro-{{ section.id }}">{{ 'glp1_guide.email.body' | t }}</p>
    {% form 'customer', id: email_form_id, class: 'glg-email-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter,olnian-guide">
      {% if form.posted_successfully? %}<p class="glg-email-status" role="status" data-email-status tabindex="-1">{{ 'glp1_guide.email.success' | t }}</p>{% else %}
        {% if form.errors %}<div class="glg-email-status" role="alert" data-email-status tabindex="-1">{{ form.errors | default_errors }}</div>{% endif %}
        <label for="GuideEmailInput-{{ section.id }}">{{ 'glp1_guide.email.label' | t }}</label>
        <input id="GuideEmailInput-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" required value="{{ form.email | escape }}" placeholder="{{ 'glp1_guide.email.placeholder' | t }}">
        <p class="glg-fine glg-email-consent">{{ 'glp1_guide.email.consent' | t }}{% if shop.privacy_policy.body != blank %} <a href="{{ shop.privacy_policy.url }}">{{ 'glp1_guide.footer.privacy' | t }}</a>{% endif %}</p>
        <button class="glg-button" type="submit">{{ 'glp1_guide.email.submit' | t }} <span aria-hidden="true">↗</span></button>
      {% endif %}
    {% endform %}
  </dialog>
  <noscript><p class="glg-wrap glg-fine">{{ 'glp1_guide.email.nojs' | t }}</p></noscript>
  <footer class="glg-footer glg-wrap"><div><a class="glg-logo" href="{{ routes.root_url }}">{{ 'glp1_guide.nav.brand' | t }}</a><span>{{ 'glp1_guide.footer.guide' | t }}</span></div><nav aria-label="{{ 'glp1_guide.footer.guide' | t }}">{% if shop.privacy_policy.body != blank %}<a href="{{ shop.privacy_policy.url }}">{{ 'glp1_guide.footer.privacy' | t }}</a>{% endif %}{% if shop.shipping_policy.body != blank %}<a href="{{ shop.shipping_policy.url }}">{{ 'glp1_guide.footer.shipping' | t }}</a>{% endif %}{% if shop.refund_policy.body != blank %}<a href="{{ shop.refund_policy.url }}">{{ 'glp1_guide.footer.returns' | t }}</a>{% endif %}<a href="mailto:{{ shop.email | escape }}">{{ 'glp1_guide.footer.contact' | t }}</a></nav><p>{{ 'glp1_guide.footer.disclaimer' | t }}</p></footer>
  <div class="glg-sticky" hidden><span>{{ 'glp1_guide.offer.sticky' | t }}</span><a class="glg-button" href="#GuideOffer-{{ section.id }}">{% if offer_active %}{{ 'glp1_guide.offer.sticky_offer' | t }}{% else %}{{ 'glp1_guide.offer.sticky_button' | t }}{% endif %}<span aria-hidden="true">↗</span></a></div>
</div>
{% stylesheet %}
.glg { --glg-blue: #0066a6; --glg-ink: #2e1206; --glg-paper: #fff8f0; color: var(--glg-ink); background: var(--glg-paper); font-family: var(--body-font); font-weight: 400; overflow: clip; }
.glg *, .glg *::before, .glg *::after { box-sizing: border-box; }
.glg [hidden] { display: none !important; }
.glg-wrap { width: min(1240px, calc(100% - 96px)); margin-inline: auto; }
.glg-space { padding-block: 100px; }
.glg h1, .glg h2, .glg h3 { font-family: var(--body-font); font-weight: 700; text-wrap: balance; }
.glg h1 { font-size: clamp(48px, 5.2vw, 76px); line-height: 1.02; letter-spacing: -.055em; max-width: 600px; margin: 28px 0 24px; }
.glg h2 { font-size: clamp(32px, 3.3vw, 48px); line-height: 1.12; letter-spacing: -.045em; }
.glg h3 { font-size: 22px; line-height: 1.25; letter-spacing: -.025em; }
.glg p { margin: 0; }
.glg a { text-underline-offset: 5px; }
.glg a:hover { text-decoration: underline; }
.glg a:focus-visible, .glg button:focus-visible, .glg summary:focus-visible, .glg select:focus-visible { outline: 3px solid currentColor; outline-offset: 5px; }
.glg [id] { scroll-margin-top: 30px; }
.glg-eyebrow { font-size: 11px; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; line-height: 1.7; margin-bottom: 20px !important; display: flex; align-items: center; gap: 9px; }
.glg-dot { width: 7px; height: 7px; border-radius: 100%; background: #c43a16; }
.glg-body { font-size: 17px; line-height: 1.75; margin-top: 22px !important; max-width: 610px; }
.glg-muted { color: #624d43; line-height: 1.7; max-width: 350px; font-size: 16px; }
.glg-fine { font-size: 12px; line-height: 1.7; }
.glg-welcome { text-align: center; background: #e8f0f4; color: #214f6b; padding: 11px 20px; font-size: 12px; font-weight: 600; }
.glg-welcome a { display: block; }
.glg-welcome span { padding-left: 10px; }
.glg-nav { display: flex; align-items: center; justify-content: space-between; padding-block: 24px; gap: 24px; border-bottom: 1px solid #2e12061a; }
.glg-logo { font-family: var(--brand-font); font-size: 31px; letter-spacing: .04em; line-height: 1; }
.glg-nav nav { display: flex; gap: 32px; font-size: 13px; }
.glg-nav-cta { font-weight: 700; font-size: 13px; display: flex; align-items: center; gap: 24px; }
.glg-hero { display: grid; grid-template-columns: .95fr 1.05fr; align-items: center; gap: 30px; padding-block: 44px 52px; }
.glg-hero-lead { font-size: 22px; line-height: 1.45; margin-bottom: 13px !important; }
.glg-hero-media { position: relative; margin: 0; height: 580px; border-radius: 160px 160px 8px 8px; overflow: hidden; background: #ede8db; }
.glg-hero-media img { height: 100%; width: 100%; object-fit: cover; object-position: 75% center; }
.glg-hero-media figcaption { position: absolute; bottom: 18px; left: 16px; right: 16px; width: fit-content; max-width: calc(100% - 32px); padding: 8px 13px; margin: auto; font-size: 10px; background: #fff8f0ed; border-radius: 4px; letter-spacing: .035em; }
.glg-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 30px; }
.glg-button { display: inline-flex; align-items: center; justify-content: center; gap: 34px; min-height: 52px; padding: 14px 25px; border: 1px solid transparent; background: #ff5a2c; color: #2e1206; border-radius: 4px; font-size: 14px; font-weight: 800; line-height: 1.4; cursor: pointer; transition: background .18s, color .18s; }
.glg-button:hover { background: #2e1206; color: #fff8f0; text-decoration: none !important; }
.glg-button:disabled { cursor: not-allowed; background: #ded6cf; color: #624d43; }
.glg-text-link { font-size: 13px; font-weight: 700; text-decoration: underline; }
.glg-facts { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid #2e120625; padding-block: 25px; gap: 20px; }
.glg-facts span { display: flex; gap: 14px; align-items: center; justify-content: center; font-size: 13px; }
.glg-facts b { color: var(--glg-blue); font-size: 21px; font-weight: 600; }
.glg-split { display: grid; grid-template-columns: 1fr 1fr; gap: 90px; align-items: start; }
.glg-learn { margin-top: 10px; background: #eaf2f6; }
.glg-definition { border-left: 1px solid #0066a638; padding: 0 0 0 48px; }
.glg-definition p { margin-top: 18px; font-size: 17px; line-height: 1.75; }
.glg-orbit { background: #0066a6; color: white; display: grid; place-items: center; width: 65px; height: 65px; border-radius: 100%; font-size: 34px; margin-bottom: 28px; }
.glg-benefits { display: grid; grid-template-columns: repeat(3,1fr); gap: 36px; margin-top: 65px; }
.glg-benefits article { border-top: 1px solid #0066a64d; padding-top: 20px; }
.glg-number { font-size: 11px; letter-spacing: .1em; display: block; margin-bottom: 26px; color: #215472; }
.glg-benefits p { margin-top: 14px; font-size: 15px; line-height: 1.65; }
.glg-learn-note { margin-top: 30px !important; color: #3c5665; max-width: 800px; }
.glg-science .glg-body { margin-top: 0 !important; }
.glg-details { border-bottom: 1px solid #2e12062e; }
.glg-details summary { display: flex; align-items: center; justify-content: space-between; gap: 20px; list-style: none; cursor: pointer; padding: 21px 0; font-size: 15px; font-weight: 700; line-height: 1.5; }
.glg-details summary::-webkit-details-marker { display: none; }
.glg-details summary span { flex-shrink: 0; font-size: 23px; line-height: 1; font-weight: 400; transition: transform .15s; }
.glg-details[open] summary span { transform: rotate(45deg); }
.glg-details > div { padding-bottom: 24px; font-size: 15px; line-height: 1.8; }
.glg-details > div p + p { margin-top: 15px; }
.glg-details ul { padding-left: 20px; margin: 0 0 20px; }
.glg-details li + li { margin-top: 12px; }
.glg-details li a { text-decoration: underline; }
.glg-comparison { background: #f2e9df; }
.glg-section-intro { max-width: 670px; }
.glg-table { width: 100%; border-collapse: collapse; table-layout: fixed; margin-top: 42px; font-size: 14px; line-height: 1.6; text-align: left; }
.glg-table th, .glg-table td { padding: 22px 25px; vertical-align: middle; border-bottom: 1px solid #2e120624; }
.glg-table th { font-weight: 600; }
.glg-table thead th { font-size: 12px; font-weight: 800; }
.glg-table td:nth-child(2), .glg-table th:nth-child(2) { background: #fff8f0; }
.glg-table thead th:nth-child(2) { background: #0066a6; color: white; }
.glg-table tbody th { padding-left: 0; }
.glg-table thead th:first-child { padding-left: 0; }
.glg-explain { gap: 50px; margin-top: 26px; }
.glg-proof-links { display: flex; flex-wrap: wrap; gap: 25px; margin-top: 30px; }
.glg-label { background: #fff; border: 1px solid #2e12062a; padding: 32px 38px; border-radius: 4px; }
