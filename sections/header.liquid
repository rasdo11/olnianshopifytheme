    { "type": "color", "id": "header_border_color", "label": "Bottom border", "default": "#F2ECE9" },
    { "type": "color", "id": "header_text_color", "label": "Menu and action text", "default": "#2E1206" },
    { "type": "color", "id": "logo_color", "label": "Logo text", "default": "#2E1206" },
