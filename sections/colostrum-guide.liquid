{% liquid
  assign guide_product = section.settings.product
  assign guide_variant = guide_product.selected_or_first_available_variant
  assign offer_active = false
  assign offer_code = section.settings.discount_code | strip
  if section.settings.offer_enabled and offer_code != blank and section.settings.discount_percent > 0
    assign offer_active = true
  endif
  if customer and customer.orders_count > 0
    assign offer_active = false
  endif
  assign price = guide_variant.price
  if offer_active
    assign discount_multiplier = 100 | minus: section.settings.discount_percent
    assign price = price | times: discount_multiplier | divided_by: 100.0 | round
  endif
  assign form_id = 'GuideForm-' | append: section.id
  assign return_url = routes.cart_url
  if offer_active
    assign encoded_code = offer_code | url_encode
    assign return_url = routes.root_url | append: 'discount/' | append: encoded_code | append: '?redirect=' | append: routes.cart_url
  endif
  assign review_count = 0
  for block in section.blocks
    if block.type == 'testimonial' and block.settings.quote != blank and block.settings.author != blank
      assign review_count = review_count | plus: 1
    endif
  endfor
%}
<div class="cg" id="Guide-{{ section.id }}">
  <div class="cg-welcome"><button type="button" data-email-open aria-haspopup="dialog" aria-controls="GuideEmail-{{ section.id }}">{{ 'colostrum_guide.email.trigger' | t }} <span aria-hidden="true">↗</span></button></div>
  <header class="cg-nav cg-wrap">
    <a class="cg-logo" href="{{ routes.root_url }}" aria-label="{{ 'colostrum_guide.nav.home' | t }}">{{ 'colostrum_guide.nav.brand' | t }}</a>
    <nav aria-label="{{ 'colostrum_guide.nav.label' | t }}">
      <a href="#GuideLearn-{{ section.id }}">{{ 'colostrum_guide.nav.learn' | t }}</a>
      <a href="#GuideFormula-{{ section.id }}">{{ 'colostrum_guide.nav.formula' | t }}</a>
    </nav>
    <a class="cg-nav-cta" href="#GuideOffer-{{ section.id }}">{{ 'colostrum_guide.nav.shop' | t }} <span aria-hidden="true">↗</span></a>
  </header>
  <section class="cg-hero cg-wrap" aria-labelledby="GuideHeading-{{ section.id }}"><div class="cg-hero-copy"><p class="cg-eyebrow">{{ 'colostrum_guide.hero.eyebrow' | t }}</p><h1 id="GuideHeading-{{ section.id }}">{% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}{{ 'colostrum_guide.hero.heading' | t }}{% endif %}</h1><p class="cg-hero-lead">{{ 'colostrum_guide.hero.body' | t }}</p></div></section>
  <section class="cg-tree cg-space cg-wrap" id="GuideFit-{{ section.id }}" aria-labelledby="GuideFitTitle-{{ section.id }}">
    <h2 class="visually-hidden" id="GuideFitTitle-{{ section.id }}">{{ 'colostrum_guide.tree.heading' | t }}</h2>
    <div class="cg-tree-interactive" hidden data-tree>
      <div class="cg-tree-choices" role="group" aria-label="{{ 'colostrum_guide.tree.heading' | t }}">
        {% assign concerns = 'digestion,immune,recovery,energy' | split: ',' %}
        {% for concern in concerns %}{% assign concern_key = 'colostrum_guide.tree.' | append: concern %}
          {% assign image_key = concern | append: '_image' %}
          <button type="button" data-tree-choice="{{ concern }}" aria-controls="GuideTreeResult-{{ section.id }}" aria-pressed="false">{% if section.settings[image_key] != blank %}{{ section.settings[image_key] | image_url: width: 800 | image_tag: widths: '240, 400, 600, 800', sizes: '(min-width: 750px) 23vw, 46vw', loading: 'eager', alt: '' }}{% endif %}<span class="cg-card-copy">{{ concern_key | t }}</span><span class="cg-tree-arrow" aria-hidden="true">↗</span></button>
        {% endfor %}
      </div>
      <div class="cg-tree-connector" aria-hidden="true"></div>
      <div class="cg-tree-result" id="GuideTreeResult-{{ section.id }}" data-tree-result aria-live="polite" aria-atomic="true"><div class="cg-tree-placeholder"><span aria-hidden="true">↓</span><h3>{{ 'colostrum_guide.tree.prompt' | t }}</h3><p>{{ 'colostrum_guide.tree.hint' | t }}</p></div></div>
      <div class="cg-tree-more" data-tree-more hidden><p>{{ 'colostrum_guide.tree.other' | t }}</p><div role="group" aria-label="{{ 'colostrum_guide.tree.other' | t }}"><button type="button" data-tree-choice="digestion" aria-controls="GuideTreeResult-{{ section.id }}" aria-pressed="false">{{ 'colostrum_guide.tree.gut_short' | t }} ↗</button><button type="button" data-tree-choice="immune" aria-controls="GuideTreeResult-{{ section.id }}" aria-pressed="false">{{ 'colostrum_guide.tree.immune_short' | t }} ↗</button><button type="button" data-tree-choice="recovery" aria-controls="GuideTreeResult-{{ section.id }}" aria-pressed="false">{{ 'colostrum_guide.tree.recovery_short' | t }} ↗</button></div></div>
    </div>
    {% assign paths = 'gut,immune,recovery,energy' | split: ',' %}{% for path in paths %}
      {% assign title_key = 'colostrum_guide.tree.' | append: path | append: '_title' %}{% assign body_key = 'colostrum_guide.tree.' | append: path | append: '_body' %}{% assign limit_key = 'colostrum_guide.tree.' | append: path | append: '_limit' %}{% assign source_key = 'colostrum_guide.tree.' | append: path | append: '_source' %}
      <template data-tree-template="{{ path }}"><div class="cg-tree-answer"><div><p class="cg-eyebrow">{{ 'colostrum_guide.tree.result_label' | t }}</p><h3 tabindex="-1">{{ title_key | t }}</h3><p class="cg-body">{{ body_key | t }}</p><a class="cg-text-link" href="#GuideFormula-{{ section.id }}">{{ 'colostrum_guide.tree.why' | t }} ↗</a></div><aside><p class="cg-eyebrow">{{ 'colostrum_guide.tree.limit_label' | t }}</p><p>{{ limit_key | t }}</p><a class="cg-text-link" href="{{ source_key | t }}" target="_blank" rel="noopener">{{ 'colostrum_guide.tree.source' | t }} ↗</a></aside></div></template>
    {% endfor %}
    <noscript><p class="cg-body">{{ 'colostrum_guide.tree.nojs' | t }}</p></noscript><p class="cg-fine cg-tree-scope">{{ 'colostrum_guide.tree.scope' | t }}</p>
  </section>
  <section class="cg-learn cg-space" id="GuideLearn-{{ section.id }}" aria-labelledby="GuideLearnTitle-{{ section.id }}">
    <div class="cg-wrap">
      <div class="cg-split">
        <div>
          <p class="cg-eyebrow">{{ 'colostrum_guide.learn.eyebrow' | t }}</p>
          <h2 id="GuideLearnTitle-{{ section.id }}">{{ 'colostrum_guide.learn.heading' | t }}</h2>
          <p class="cg-body">{{ 'colostrum_guide.learn.intro' | t }}</p>
          <p class="cg-body">{{ 'colostrum_guide.learn.body' | t }}</p>
        <details class="cg-details">
          <summary>{{ 'colostrum_guide.science.link' | t }}<span aria-hidden="true">+</span></summary>
          <div><p>{{ 'colostrum_guide.science.body' | t }}</p><ul><li><a href="https://pubmed.ncbi.nlm.nih.gov/28397754/" target="_blank" rel="noopener">{{ 'colostrum_guide.science.study1' | t }}</a></li><li><a href="https://pubmed.ncbi.nlm.nih.gov/25068884/" target="_blank" rel="noopener">{{ 'colostrum_guide.science.study2' | t }}</a></li></ul><p>{{ 'colostrum_guide.science.limit' | t }}</p></div>
        </details>
        </div>
        {% if section.settings.lifestyle_image != blank %}
          <figure class="cg-lifestyle">{% assign lifestyle_alt = 'colostrum_guide.learn.photo_alt' | t %}{{ section.settings.lifestyle_image | image_url: width: 1100 | image_tag: widths: '400, 650, 900, 1100', sizes: '(min-width: 750px) 45vw, 90vw', loading: 'lazy', alt: lifestyle_alt }}<figcaption>{{ 'colostrum_guide.learn.photo_caption' | t }}</figcaption></figure>
        {% endif %}
      </div>
    </div>
  </section>
  <section class="cg-month cg-space" id="GuideFormula-{{ section.id }}" aria-labelledby="GuideFormulaTitle-{{ section.id }}">
    <div class="cg-wrap">
      <h2 class="visually-hidden" id="GuideFormulaTitle-{{ section.id }}">{{ 'colostrum_guide.month.heading' | t }}</h2>
      {% if section.settings.timeline_image != blank %}
        <p class="cg-fine cg-month-hint" id="GuideMonthHint-{{ section.id }}">{{ 'colostrum_guide.month.swipe' | t }}</p>
        <div class="cg-month-scroll" tabindex="0" role="region" aria-label="{{ 'colostrum_guide.month.heading' | t }}" aria-describedby="GuideMonthHint-{{ section.id }}">
          {% assign month_alt = 'colostrum_guide.month.alt' | t %}
          {{ section.settings.timeline_image | image_url: width: 2400 | image_tag: widths: '1100, 1600, 2200, 2400', sizes: '(min-width: 1200px) 1240px, 1100px', loading: 'lazy', alt: month_alt }}
        </div>
      {% endif %}
      <details class="cg-details cg-month-transcript" {% if section.settings.timeline_image == blank %}open{% endif %}><summary>{{ 'colostrum_guide.month.read' | t }}<span aria-hidden="true">+</span></summary><div>
        <p>{{ 'colostrum_guide.month.intro' | t }}</p>
        {% for day in (1..3) %}{% assign title_key = 'colostrum_guide.month.title' | append: day %}{% assign body_key = 'colostrum_guide.month.body' | append: day %}<h3>{{ title_key | t }}</h3><p>{{ body_key | t }}</p>{% endfor %}
        <p>{{ 'colostrum_guide.month.science' | t }}</p><p>{{ 'colostrum_guide.month.safety' | t }}</p>
      </div></details>
      {% if section.settings.facts_image != blank %}<details class="cg-details cg-facts-disclosure"><summary>{{ 'colostrum_guide.proof.facts' | t }}<span aria-hidden="true">+</span></summary><div>{% assign facts_alt = 'colostrum_guide.proof.alt' | t %}{{ section.settings.facts_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: facts_alt }}</div></details>{% endif %}
    {% if review_count > 0 %}
      <div class="cg-reviews"><h3>{{ 'colostrum_guide.proof.reviews' | t }}</h3><div class="cg-review-grid">{% for block in section.blocks %}{% if block.type == 'testimonial' and block.settings.quote != blank and block.settings.author != blank %}<figure {{ block.shopify_attributes }}><blockquote>{{ block.settings.quote | escape }}</blockquote><figcaption>{{ block.settings.author | escape }}</figcaption>{% if block.settings.source_url != blank %}<a class="cg-text-link" href="{{ block.settings.source_url }}">{{ block.settings.source_label | escape }}</a>{% endif %}</figure>{% endif %}{% endfor %}</div></div>
    {% endif %}    </div>
  </section>
  <section class="cg-offer cg-space" id="GuideOffer-{{ section.id }}" aria-labelledby="GuideOfferTitle-{{ section.id }}">
    <div class="cg-wrap cg-offer-grid">
      <div class="cg-offer-image">{% assign offer_image = section.settings.offer_image | default: guide_product.featured_image %}{% if offer_image != blank %}{{ offer_image | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 900px) 45vw, 90vw', loading: 'lazy', alt: guide_product.title }}{% endif %}</div>
      <div class="cg-offer-copy">
        <p class="cg-eyebrow">{{ 'colostrum_guide.offer.eyebrow' | t }}</p><h2 id="GuideOfferTitle-{{ section.id }}">{{ 'colostrum_guide.offer.heading' | t }}</h2><p class="cg-body">{{ 'colostrum_guide.offer.body' | t }}</p>
        {% if guide_product != blank %}
          {% if offer_active %}<p class="cg-offer-badge">{{ 'colostrum_guide.offer.badge' | t: percent: section.settings.discount_percent }}</p>{% endif %}
          <h3>{{ 'colostrum_guide.offer.name' | t }}</h3><p class="cg-fine">{{ 'colostrum_guide.offer.size' | t }}</p>
          <div class="cg-price" aria-live="polite">
            {% if offer_active %}<s><span class="visually-hidden">{{ 'colostrum_guide.offer.regular' | t }}</span><span data-guide-original>{{ guide_variant.price | money }}</span></s>{% endif %}
            <strong><span class="visually-hidden">{% if offer_active %}{{ 'colostrum_guide.offer.eligible_price' | t }}{% else %}{{ 'colostrum_guide.offer.price_label' | t }}{% endif %}</span><span data-guide-price>{{ price | money }}</span></strong>
          </div>
          {% unless guide_product.requires_selling_plan %}<p class="cg-one-time">{{ 'colostrum_guide.offer.one_time' | t }}</p>{% endunless %}
          {% if guide_product.requires_selling_plan %}
            <a class="cg-button" href="{{ guide_product.url }}">{{ 'colostrum_guide.offer.subscription' | t }}</a>
          {% else %}
            {% form 'product', guide_product, id: form_id, return_to: return_url, class: 'cg-product-form' %}
              {{ form.errors | default_errors }}
              {% if guide_product.variants.size > 1 %}
                <label for="GuideVariant-{{ section.id }}">{{ 'colostrum_guide.offer.variant' | t }}</label>
                <select id="GuideVariant-{{ section.id }}" name="id" data-guide-variant>
                  {% for variant in guide_product.variants %}
                    {% assign option_price = variant.price %}{% if offer_active %}{% assign option_price = option_price | times: discount_multiplier | divided_by: 100.0 | round %}{% endif %}{% assign option_serving = option_price | divided_by: 30.0 | round | money %}
                    <option value="{{ variant.id }}" data-price="{{ option_price | money | escape }}" data-original="{{ variant.price | money | escape }}" data-serving="{{ 'colostrum_guide.offer.per_day' | t: amount: option_serving | escape }}" {% unless variant.available %}disabled{% endunless %} {% if variant.id == guide_variant.id %}selected{% endif %}>{{ variant.title | escape }} — {{ option_price | money }}{% unless variant.available %} — {{ 'colostrum_guide.offer.sold_out' | t }}{% endunless %}</option>
                  {% endfor %}
                </select>
              {% else %}<input type="hidden" name="id" value="{{ guide_variant.id }}">{% endif %}
              <input type="hidden" name="quantity" value="1">
              <button class="cg-button cg-buy" type="submit" {% unless guide_variant.available %}disabled{% endunless %}>{% unless guide_variant.available %}{{ 'colostrum_guide.offer.sold_out' | t }}{% else %}{% if offer_active %}{{ 'colostrum_guide.offer.discount_button' | t }}{% else %}{{ 'colostrum_guide.offer.button' | t }}{% endif %}<span aria-hidden="true">↗</span>{% endunless %}</button>
            {% endform %}
          {% endif %}
          {% if offer_active %}<p class="cg-fine cg-terms">{{ 'colostrum_guide.offer.terms' | t }}</p>{% endif %}
          <p class="cg-fine cg-shipping">{{ 'colostrum_guide.offer.shipping' | t }}</p><a class="cg-text-link" href="{{ guide_product.url }}">{{ 'colostrum_guide.offer.details' | t }} ↗</a>
        {% else %}<p>{{ 'colostrum_guide.offer.unavailable' | t }}</p>{% if request.design_mode %}<p>{{ 'colostrum_guide.offer.editor' | t }}</p>{% endif %}{% endif %}
      </div>
    </div>
  </section>
  {% assign email_form_id = 'GuideEmailForm-' | append: section.id %}
  <dialog class="cg-email-dialog" id="GuideEmail-{{ section.id }}" aria-labelledby="GuideEmailTitle-{{ section.id }}" aria-describedby="GuideEmailIntro-{{ section.id }}">
    <button type="button" class="cg-email-close" data-email-close aria-label="{{ 'colostrum_guide.email.close' | t }}">×</button>
    <p class="cg-eyebrow">{{ 'colostrum_guide.email.eyebrow' | t }}</p><h2 id="GuideEmailTitle-{{ section.id }}">{{ 'colostrum_guide.email.heading' | t }}</h2><p class="cg-body" id="GuideEmailIntro-{{ section.id }}">{{ 'colostrum_guide.email.body' | t }}</p>
    {% form 'customer', id: email_form_id, class: 'cg-email-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter,colostrum-guide,chatgpt-deal-reminder">
      {% if form.posted_successfully? %}<p class="cg-email-status" role="status" data-email-status tabindex="-1">{{ 'colostrum_guide.email.success' | t }}</p>{% else %}
        {% if form.errors %}<div class="cg-email-status" role="alert" data-email-status tabindex="-1">{{ form.errors | default_errors }}</div>{% endif %}
        <label for="GuideEmailInput-{{ section.id }}">{{ 'colostrum_guide.email.label' | t }}</label>
        <input id="GuideEmailInput-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" required value="{{ form.email | escape }}" placeholder="{{ 'colostrum_guide.email.placeholder' | t }}">
        <p class="cg-fine cg-email-consent">{{ 'colostrum_guide.email.consent' | t }}{% if shop.privacy_policy.body != blank %} <a href="{{ shop.privacy_policy.url }}">{{ 'colostrum_guide.footer.privacy' | t }}</a>{% endif %}</p>
        <button class="cg-button" type="submit">{{ 'colostrum_guide.email.submit' | t }} <span aria-hidden="true">↗</span></button>
      {% endif %}
    {% endform %}
  </dialog>
  <noscript><p class="cg-wrap cg-fine">{{ 'colostrum_guide.email.nojs' | t }}</p></noscript>
  <footer class="cg-footer cg-wrap"><div><a class="cg-logo" href="{{ routes.root_url }}">{{ 'colostrum_guide.nav.brand' | t }}</a><span>{{ 'colostrum_guide.footer.guide' | t }}</span></div><nav aria-label="{{ 'colostrum_guide.footer.guide' | t }}">{% if shop.privacy_policy.body != blank %}<a href="{{ shop.privacy_policy.url }}">{{ 'colostrum_guide.footer.privacy' | t }}</a>{% endif %}{% if shop.shipping_policy.body != blank %}<a href="{{ shop.shipping_policy.url }}">{{ 'colostrum_guide.footer.shipping' | t }}</a>{% endif %}{% if shop.refund_policy.body != blank %}<a href="{{ shop.refund_policy.url }}">{{ 'colostrum_guide.footer.returns' | t }}</a>{% endif %}<a href="mailto:{{ shop.email | escape }}">{{ 'colostrum_guide.footer.contact' | t }}</a></nav><p>{{ 'colostrum_guide.footer.disclaimer' | t }}</p></footer>
  <div class="cg-sticky" hidden><span>{{ 'colostrum_guide.offer.sticky' | t }}</span><a class="cg-button" href="#GuideOffer-{{ section.id }}">{% if offer_active %}{{ 'colostrum_guide.offer.sticky_offer' | t }}{% else %}{{ 'colostrum_guide.offer.sticky_button' | t }}{% endif %}<span aria-hidden="true">↗</span></a></div>
</div>
{% stylesheet %}
.cg { --cg-blue: #0066a6; --cg-ink: #2e1206; --cg-paper: #fff8f0; color: var(--cg-ink); background: var(--cg-paper); font-family: var(--body-font); font-weight: 400; overflow: clip; }
.cg *, .cg *::before, .cg *::after { box-sizing: border-box; }
.cg [hidden] { display: none !important; }
.cg-wrap { width: min(1240px, calc(100% - 96px)); margin-inline: auto; }
.cg-space { padding-block: 100px; }
.cg h1, .cg h2, .cg h3 { font-family: var(--body-font); font-weight: 700; text-wrap: balance; }
.cg h1 { font-size: clamp(48px, 5.2vw, 76px); line-height: 1.02; letter-spacing: -.055em; max-width: 600px; margin: 28px 0 24px; }
.cg h2 { font-size: clamp(32px, 3.3vw, 48px); line-height: 1.12; letter-spacing: -.045em; }
.cg h3 { font-size: 22px; line-height: 1.25; letter-spacing: -.025em; }
.cg p { margin: 0; }
.cg a { text-underline-offset: 5px; }
.cg a:hover { text-decoration: underline; }
.cg a:focus-visible, .cg button:focus-visible, .cg summary:focus-visible, .cg select:focus-visible { outline: 3px solid currentColor; outline-offset: 5px; }
.cg [id] { scroll-margin-top: 30px; }
.cg-eyebrow { font-size: 11px; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; line-height: 1.7; margin-bottom: 20px !important; display: flex; align-items: center; gap: 9px; }
.cg-dot { width: 7px; height: 7px; border-radius: 100%; background: #c43a16; }
.cg-body { font-size: 17px; line-height: 1.75; margin-top: 22px !important; max-width: 610px; }
.cg-muted { color: #624d43; line-height: 1.7; max-width: 350px; font-size: 16px; }
.cg-fine { font-size: 12px; line-height: 1.7; }
.cg-welcome { text-align: center; background: #e8f0f4; color: #214f6b; padding: 11px 20px; font-size: 12px; font-weight: 600; }
.cg-welcome a { display: block; }
.cg-welcome span { padding-left: 10px; }
.cg-nav { display: flex; align-items: center; justify-content: space-between; padding-block: 24px; gap: 24px; border-bottom: 1px solid #2e12061a; }
.cg-logo { font-family: var(--brand-font); font-size: 31px; letter-spacing: .04em; line-height: 1; }
.cg-nav nav { display: flex; gap: 32px; font-size: 13px; }
.cg-nav-cta { font-weight: 700; font-size: 13px; display: flex; align-items: center; gap: 24px; }
.cg-hero { display: grid; grid-template-columns: .95fr 1.05fr; align-items: center; gap: 30px; padding-block: 44px 52px; }
.cg-hero-lead { font-size: 22px; line-height: 1.45; margin-bottom: 13px !important; }
.cg-hero-media { position: relative; margin: 0; height: 580px; border-radius: 160px 160px 8px 8px; overflow: hidden; background: #ede8db; }
.cg-hero-media img { height: 100%; width: 100%; object-fit: cover; object-position: 75% center; }
.cg-hero-media figcaption { position: absolute; bottom: 18px; left: 16px; right: 16px; width: fit-content; max-width: calc(100% - 32px); padding: 8px 13px; margin: auto; font-size: 10px; background: #fff8f0ed; border-radius: 4px; letter-spacing: .035em; }
.cg-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 30px; }
.cg-button { display: inline-flex; align-items: center; justify-content: center; gap: 34px; min-height: 52px; padding: 14px 25px; border: 1px solid transparent; background: #ff5a2c; color: #2e1206; border-radius: 4px; font-size: 14px; font-weight: 800; line-height: 1.4; cursor: pointer; transition: background .18s, color .18s; }
.cg-button:hover { background: #2e1206; color: #fff8f0; text-decoration: none !important; }
.cg-button:disabled { cursor: not-allowed; background: #ded6cf; color: #624d43; }
.cg-text-link { font-size: 13px; font-weight: 700; text-decoration: underline; }
.cg-facts { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid #2e120625; padding-block: 25px; gap: 20px; }
.cg-facts span { display: flex; gap: 14px; align-items: center; justify-content: center; font-size: 13px; }
.cg-facts b { color: var(--cg-blue); font-size: 21px; font-weight: 600; }
.cg-split { display: grid; grid-template-columns: 1fr 1fr; gap: 90px; align-items: start; }
.cg-learn { margin-top: 10px; background: #eaf2f6; }
.cg-definition { border-left: 1px solid #0066a638; padding: 0 0 0 48px; }
.cg-definition p { margin-top: 18px; font-size: 17px; line-height: 1.75; }
.cg-orbit { background: #0066a6; color: white; display: grid; place-items: center; width: 65px; height: 65px; border-radius: 100%; font-size: 34px; margin-bottom: 28px; }
.cg-benefits { display: grid; grid-template-columns: repeat(3,1fr); gap: 36px; margin-top: 65px; }
.cg-benefits article { border-top: 1px solid #0066a64d; padding-top: 20px; }
.cg-number { font-size: 11px; letter-spacing: .1em; display: block; margin-bottom: 26px; color: #215472; }
.cg-benefits p { margin-top: 14px; font-size: 15px; line-height: 1.65; }
.cg-learn-note { margin-top: 30px !important; color: #3c5665; max-width: 800px; }
.cg-science .cg-body { margin-top: 0 !important; }
.cg-details { border-bottom: 1px solid #2e12062e; }
.cg-details summary { display: flex; align-items: center; justify-content: space-between; gap: 20px; list-style: none; cursor: pointer; padding: 21px 0; font-size: 15px; font-weight: 700; line-height: 1.5; }
.cg-details summary::-webkit-details-marker { display: none; }
.cg-details summary span { flex-shrink: 0; font-size: 23px; line-height: 1; font-weight: 400; transition: transform .15s; }
.cg-details[open] summary span { transform: rotate(45deg); }
.cg-details > div { padding-bottom: 24px; font-size: 15px; line-height: 1.8; }
.cg-details > div p + p { margin-top: 15px; }
