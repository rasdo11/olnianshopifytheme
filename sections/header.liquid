{%- liquid
  case section.settings.menu_font_family
    when 'heading'
      assign header_menu_font = 'var(--display-font)'
    when 'brand'
      assign header_menu_font = 'var(--brand-font)'
    else
      assign header_menu_font = 'var(--body-font)'
  endcase

  case section.settings.action_font_family
    when 'heading'
      assign header_action_font = 'var(--display-font)'
    when 'brand'
      assign header_action_font = 'var(--brand-font)'
    else
      assign header_action_font = 'var(--body-font)'
  endcase

  case section.settings.logo_font_family
    when 'heading'
      assign header_logo_font = 'var(--display-font)'
    when 'body'
      assign header_logo_font = 'var(--body-font)'
    else
      assign header_logo_font = 'var(--brand-font)'
  endcase

  case section.settings.mobile_menu_font_family
    when 'heading'
      assign header_mobile_menu_font = 'var(--display-font)'
    when 'body'
      assign header_mobile_menu_font = 'var(--body-font)'
    else
      assign header_mobile_menu_font = 'var(--brand-font)'
  endcase
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --header-background: {{ section.settings.header_background }};
    --header-border-color: {{ section.settings.header_border_color }};
    --header-text-color: {{ section.settings.header_text_color }};
    --header-logo-color: {{ section.settings.logo_color }};
    --header-utility-color: {{ section.settings.utility_color }};
    --header-menu-font: {{ header_menu_font }};
    --header-menu-size: {{ section.settings.menu_font_size }}px;
    --header-menu-weight: {{ section.settings.menu_font_weight }};
    --header-action-font: {{ header_action_font }};
    --header-cart-size: {{ section.settings.cart_font_size }}px;
    --header-cart-weight: {{ section.settings.cart_font_weight }};
    --header-utility-size: {{ section.settings.utility_font_size }}px;
    --header-utility-weight: {{ section.settings.utility_font_weight }};
    --header-quiz-size: {{ section.settings.quiz_font_size }}px;
    --header-quiz-weight: {{ section.settings.quiz_font_weight }};
    --header-logo-font: {{ header_logo_font }};
    --header-logo-size: {{ section.settings.logo_font_size }}px;
    --header-logo-mobile-size: {{ section.settings.logo_mobile_font_size }}px;
    --header-logo-weight: {{ section.settings.logo_font_weight }};
    --header-quiz-background: {{ section.settings.quiz_background }};
    --header-quiz-text: {{ section.settings.quiz_text_color }};
    --header-quiz-border: {{ section.settings.quiz_border_color }};
    --header-quiz-hover-background: {{ section.settings.quiz_hover_background }};
    --header-quiz-hover-text: {{ section.settings.quiz_hover_text_color }};
    --header-cart-badge-background: {{ section.settings.cart_badge_background }};
    --header-cart-badge-text: {{ section.settings.cart_badge_text_color }};
    --header-mobile-menu-background: {{ section.settings.mobile_menu_background }};
    --header-mobile-menu-text: {{ section.settings.mobile_menu_text_color }};
    --header-mobile-menu-font: {{ header_mobile_menu_font }};
    --header-mobile-menu-size: {{ section.settings.mobile_menu_font_size }}px;
    --header-mobile-menu-weight: {{ section.settings.mobile_menu_font_weight }};
    --header-mobile-menu-logo-size: {{ section.settings.mobile_menu_logo_size }}px;
    --header-mobile-quiz-background: {{ section.settings.mobile_quiz_background }};
    --header-mobile-quiz-text: {{ section.settings.mobile_quiz_text_color }};
    --header-mobile-quiz-border: {{ section.settings.mobile_quiz_border_color }};
    --header-mobile-quiz-size: {{ section.settings.mobile_quiz_font_size }}px;
  }

  #shopify-section-{{ section.id }} .site-header {
    background: var(--header-background);
    color: var(--header-text-color);
    border-bottom-color: var(--header-border-color);
  }

  #shopify-section-{{ section.id }} .site-header__nav {
    font-family: var(--header-menu-font);
    font-size: var(--header-menu-size);
    font-weight: var(--header-menu-weight);
  }

  #shopify-section-{{ section.id }} .site-header__logo,
  #shopify-section-{{ section.id }} .site-nav-overlay__logo {
    color: var(--header-logo-color);
    font-family: var(--header-logo-font);
    font-size: var(--header-logo-size);
    font-weight: var(--header-logo-weight);
  }

  #shopify-section-{{ section.id }} .site-header__actions,
  #shopify-section-{{ section.id }} .site-header__cart,
  #shopify-section-{{ section.id }} .site-header__utility,
  #shopify-section-{{ section.id }} .site-header__quiz {
    font-family: var(--header-action-font);
  }

  #shopify-section-{{ section.id }} .site-header__cart {
    font-size: var(--header-cart-size);
    font-weight: var(--header-cart-weight);
  }

  #shopify-section-{{ section.id }} .site-header__utility {
    color: var(--header-utility-color);
    font-size: var(--header-utility-size);
    font-weight: var(--header-utility-weight);
  }

  #shopify-section-{{ section.id }} .site-header__quiz {
    background: var(--header-quiz-background);
    color: var(--header-quiz-text);
    border-color: var(--header-quiz-border);
    font-size: var(--header-quiz-size);
    font-weight: var(--header-quiz-weight);
  }

  #shopify-section-{{ section.id }} .site-header__quiz:hover,
  #shopify-section-{{ section.id }} .site-header__quiz:focus-visible {
    background: var(--header-quiz-hover-background);
    color: var(--header-quiz-hover-text);
  }

  #shopify-section-{{ section.id }} .site-header__cart-count {
    background: var(--header-cart-badge-background);
    color: var(--header-cart-badge-text);
  }

  #shopify-section-{{ section.id }} .site-header__hamburger span {
    background: var(--header-text-color);
  }

  #shopify-section-{{ section.id }} .site-nav-overlay {
    background: var(--header-mobile-menu-background);
    color: var(--header-mobile-menu-text);
  }

  #shopify-section-{{ section.id }} .site-nav-overlay__logo {
    color: var(--header-mobile-menu-text);
    font-size: var(--header-mobile-menu-logo-size);
  }

  #shopify-section-{{ section.id }} .site-nav-overlay__links a {
    font-family: var(--header-mobile-menu-font);
    font-size: var(--header-mobile-menu-size);
    font-weight: var(--header-mobile-menu-weight);
  }

  #shopify-section-{{ section.id }} .site-nav-overlay__quiz {
    background: var(--header-mobile-quiz-background);
    color: var(--header-mobile-quiz-text);
    border: 1.5px solid var(--header-mobile-quiz-border);
    font-family: var(--header-action-font);
    font-size: var(--header-mobile-quiz-size);
    font-weight: var(--header-quiz-weight);
  }

  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} .site-header__logo {
      font-size: var(--header-logo-mobile-size);
    }
  }
{% endstyle %}

<header class="site-header" role="banner">
  <div class="container site-header__inner">
    <div class="site-header__left">
      <button class="site-header__hamburger" id="SiteNavToggle" aria-expanded="false" aria-controls="SiteNavOverlay" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
      <nav class="site-header__nav" id="SiteNav" aria-label="Primary">
        {%- render 'header-menu-links', section: section -%}
      </nav>
    </div>

    <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="{{ shop.name }}">
      {{ settings.brand_name | default: shop.name }}
    </a>

    <div class="site-header__actions">
      {%- if section.settings.show_quiz_link -%}
        <button type="button" class="site-header__quiz" data-quiz-open aria-haspopup="dialog">{{ section.settings.quiz_link_label | default: 'Take the quiz' }}</button>
      {%- endif -%}
      {%- if section.settings.utility_text != blank -%}
        {%- if section.settings.utility_link != blank -%}
          <a href="{{ section.settings.utility_link }}" class="site-header__utility"{% if section.settings.utility_tooltip != blank %} data-shipping-tooltip="{{ section.settings.utility_tooltip | escape }}"{% endif %}>{{ section.settings.utility_text }}</a>
        {%- else -%}
          <span class="site-header__utility" tabindex="0"{% if section.settings.utility_tooltip != blank %} data-shipping-tooltip="{{ section.settings.utility_tooltip | escape }}"{% endif %}>{{ section.settings.utility_text }}</span>
        {%- endif -%}
      {%- endif -%}
      <button class="site-header__cart" data-cart-open aria-label="{{ 'general.accessibility.open_cart' | t }}">
        Cart
        <span class="site-header__cart-count"{% if cart.item_count == 0 %} style="display:none"{% endif %}>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</header>

{%- comment -%} Full-screen takeover menu (mobile) {%- endcomment -%}
<div class="site-nav-overlay" id="SiteNavOverlay" aria-hidden="true" role="dialog" aria-label="Menu">
  <div class="site-nav-overlay__bar">
    <a href="{{ routes.root_url }}" class="site-nav-overlay__logo" aria-label="{{ shop.name }}">
      {{ settings.brand_name | default: shop.name }}
    </a>
    <button class="site-nav-overlay__close" data-nav-close aria-label="Close menu">&times;</button>
  </div>
  <nav class="site-nav-overlay__links" aria-label="Mobile primary">
    {%- render 'header-menu-links', section: section -%}
    {%- if section.settings.show_quiz_link -%}
      <button type="button" class="site-nav-overlay__quiz" data-quiz-open data-nav-close aria-haspopup="dialog">{{ section.settings.quiz_link_label | default: 'Take the quiz' }}</button>
    {%- endif -%}
  </nav>
  {%- if section.settings.utility_text != blank -%}
    <div class="site-nav-overlay__footer">
      <span class="site-header__utility">{{ section.settings.utility_text }}</span>
    </div>
  {%- endif -%}
</div>

