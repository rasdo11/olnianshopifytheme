{%- comment -%}
  Open Graph + Twitter Card tags for rich link previews (iMessage, WhatsApp, Facebook, X).
  Product pages get their OWN card: the product's title, its first product image, and its
  description, so each shared product link previews as that product. Every other page
  (home, collections, static pages) falls back to the brand-wide card:
  "{Store name} | {Tagline}" plus the Shared link image setting.
{%- endcomment -%}
{%- liquid
  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif

  comment
    Brand-wide defaults, used on every non-product page.
  endcomment
  assign og_title = shop.name
  if settings.brand_tagline != blank
    assign og_title = shop.name | append: ' | ' | append: settings.brand_tagline
  endif
  assign og_image = settings.social_share_image
  assign og_desc = page_description | default: shop.description | default: settings.brand_tagline | default: shop.name

  comment
    On a product page, make the card reflect the product itself: its own title, its FIRST
    product image, and its description. product.images.first is the first image in the
    product's media order (what the user means by "first product image"); featured_image is
    a fallback if the first entry isn't an image. This overrides the single brand-wide share
    image so every product's shared link is distinct.
  endcomment
  if request.page_type == 'product' and product
    assign og_title = product.title
    if product.images.first
      assign og_image = product.images.first
    elsif product.featured_image
      assign og_image = product.featured_image
    endif
    assign og_desc = page_description | default: product.description | strip_html | truncatewords: 50 | default: og_desc
  endif

  comment
    Last-resort fallbacks so a card never renders imageless.
  endcomment
  if og_image == blank and product.featured_image
    assign og_image = product.featured_image
  endif
  if og_image == blank and article.image
    assign og_image = article.image
  endif
-%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_desc | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">
{%- if og_image -%}
  {%- comment -%}
    image_url returns a PROTOCOL-RELATIVE url (//cdn.shopify.com/...). Open Graph requires an
    absolute one, and scrapers — iMessage, WhatsApp, Facebook, Slack — drop the image when the
    scheme is missing, which is why shared links showed no thumbnail. The `contains` test has
    to sit in an if/else: Liquid's `assign` can't evaluate `contains` as a boolean.

    Cropped to 1200x630, the standard large-card ratio, so the declared dimensions are always
    truthful — a mismatch makes some scrapers discard the image outright.

    Do not force a different output format here. Apple Link Presentation infers the shared
    item's type from the URL extension. A `.png` URL serving JPEG bytes can work when Messages
    fetches the URL itself, but render as an empty image when Chrome passes that metadata through
    the iOS share sheet. Keeping the source format makes the URL, HTTP Content-Type, and bytes agree.
  {%- endcomment -%}
  {%- assign og_image_src = og_image | image_url: width: 1200, height: 630, crop: 'center' -%}
  {%- if og_image_src contains '://' -%}
    {%- assign og_image_url = og_image_src -%}
  {%- else -%}
    {%- assign og_image_url = og_image_src | prepend: 'https:' -%}
  {%- endif -%}
  <meta property="og:image" content="{{ og_image_url | escape }}">
  <meta property="og:image:url" content="{{ og_image_url | escape }}">
  <meta property="og:image:secure_url" content="{{ og_image_url | escape }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ og_image.alt | default: og_title | escape }}">
{%- endif -%}
{%- if request.page_type == 'product' and product -%}
  <meta property="product:price:amount" content="{{ product.price | divided_by: 100.0 }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="og:availability" content="{% if product.available %}instock{% else %}oos{% endif %}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_desc | escape }}">
{%- if og_image -%}
  {%- comment -%} Same absolute-URL requirement as og:image above. {%- endcomment -%}
  <meta name="twitter:image" content="{{ og_image_url | escape }}">
  <meta name="twitter:image:alt" content="{{ og_image.alt | default: og_title | escape }}">
{%- endif -%}
