{% javascript %}
(() => {
  const initialize = (scope) => {
    scope.querySelectorAll('.glg:not([data-guide-ready])').forEach((guide) => {
      guide.dataset.guideReady = 'true';
      let fitVisible = false;
      let refreshSticky = () => {};
      const fit = guide.querySelector('[data-tree]');
      const result = guide.querySelector('[data-tree-result]');
      if (fit && result) {
        fit.hidden = false;
        guide.querySelectorAll('[data-tree-choice]').forEach((button) => {
          button.addEventListener('click', () => {
            const choice = button.dataset.treeChoice;
            const path = choice;
            const template = guide.querySelector(`[data-tree-template="${path}"]`);
            if (!template) return;
            guide.querySelectorAll('[data-tree-choice]').forEach((item) => {
              item.setAttribute('aria-pressed', String(item.dataset.treeChoice === choice));
            });
            result.replaceChildren(template.content.cloneNode(true));
            guide.querySelector('[data-tree-more]').hidden = false;
            result.querySelector('h3').focus({ preventScroll: true });
            result.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'nearest' });
          });
        });
      }
      const sticky = guide.querySelector('.glg-sticky');
      const hero = guide.querySelector('.glg-hero');
      const offer = guide.querySelector('.glg-offer');
      if ('IntersectionObserver' in window && sticky && hero && offer) {
        let pastHero = false;
        let reachedOffer = false;
        refreshSticky = () => { sticky.hidden = !pastHero || reachedOffer || fitVisible; };
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.target === fit) fitVisible = entry.isIntersecting;
            if (entry.target === hero) pastHero = entry.boundingClientRect.bottom < 0;
            if (entry.target === offer) {
              reachedOffer = entry.isIntersecting || entry.boundingClientRect.top < 0;
            }
          });
          refreshSticky();
        });
        observer.observe(hero);
        observer.observe(offer);
        if (fit) observer.observe(fit);
        document.addEventListener('shopify:section:unload', (event) => {
          if (event.target.contains(guide)) observer.disconnect();
        }, { once: true });
      }
      const emailDialog = guide.querySelector('.glg-email-dialog');
      if (emailDialog) {
        let emailOpener;
        const openEmail = () => {
          emailOpener = document.activeElement;
          if (!emailDialog.open) emailDialog.showModal();
          (emailDialog.querySelector('[data-email-status]') || emailDialog.querySelector('input[type="email"]'))?.focus();
        };
        guide.querySelectorAll('[data-email-open]').forEach(button => button.addEventListener('click', openEmail));
        emailDialog.querySelector('[data-email-close]').addEventListener('click', () => emailDialog.close());
        emailDialog.addEventListener('click', event => {
          if (event.target !== emailDialog) return;
          const box = emailDialog.getBoundingClientRect();
          if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) emailDialog.close();
        });
        emailDialog.addEventListener('close', () => emailOpener?.focus());
        if (emailDialog.querySelector('[data-email-status]')) openEmail();
      }
      const liveOffer = guide.querySelector('[data-live-offer]');
      if (liveOffer) {
        fetch(liveOffer.dataset.productUrl + '.js', { credentials: 'same-origin' })
          .then(response => { if (!response.ok) throw new Error('Unavailable'); return response.json(); })
          .then(product => {
            const variant = product.variants.find(item => String(item.id) === '44512991608898');
            if (!variant || variant.requires_selling_plan) return;
            const percent = Number(liveOffer.dataset.percent) || 0;
            const money = new Intl.NumberFormat(document.documentElement.lang || 'en', {style:'currency',currency:liveOffer.dataset.currency || 'USD'});
            liveOffer.querySelector('[data-guide-price]').textContent = money.format(Math.round(variant.price * (100-percent) / 100) / 100);
            const original = liveOffer.querySelector('[data-guide-original]');
            if (original) original.textContent = money.format(variant.price / 100);
            const button = liveOffer.querySelector('.glg-buy');
            button.disabled = !variant.available;
            button.textContent = !variant.available ? liveOffer.dataset.soldLabel : percent > 0 ? liveOffer.dataset.buyLabel : liveOffer.dataset.standardLabel;
            liveOffer.hidden = false;
          }).catch(() => {});
      }
    });
  };
  initialize(document);
  document.addEventListener('shopify:section:load', (event) => initialize(event.target));
})();
{% endjavascript %}
