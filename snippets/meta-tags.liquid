{%- comment -%}
  Open Graph + Twitter Card tags for rich link previews (iMessage, WhatsApp, Facebook, X).
  Title and image are fixed brand-wide (not per-page) so every shared link looks the same:
  "{Store name} | {Tagline}" plus the brand's shared link image.
{%- endcomment -%}
{%- liquid
  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif
  assign og_title = shop.name | append: ' | ' | append: settings.brand_tagline
  assign og_image = settings.social_share_image
  assign og_desc = page_description | default: shop.description | default: shop.name
-%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_desc | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
{%- if og_image -%}
  {%- assign og_h = og_image.height | times: 1200 | divided_by: og_image.width -%}
  <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ og_h }}">
  <meta property="og:image:alt" content="{{ og_image.alt | default: og_title | escape }}">
{%- endif -%}
{%- if request.page_type == 'product' and product -%}
  <meta property="product:price:amount" content="{{ product.price | divided_by: 100.0 }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="og:availability" content="{% if product.available %}instock{% else %}oos{% endif %}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_desc | escape }}">
{%- if og_image -%}
  <meta name="twitter:image" content="https:{{ og_image | image_url: width: 1200 }}">
{%- endif -%}
